  ref(): externref { return this.#ref; }
  static create(): Flags { return new Flags(__Flags_create()); }
  verbose: externref { get { return __Flags_verbose(this.#ref); } }
  set_verbose(value: boolean): void { __Flags_set_verbose(this.#ref, value); }
}

export function fetch(input: RequestInfo): externref { return __fetch(input); }
export function fetch_with_init(input: RequestInfo, init: RequestInit): externref { return __fetch_with_init(input, init.ref()); }
export function console(): Console { return new Console(__console()); }
export function join_all(sep: String, parts: FixedArray<anyref>): String { return String.fromHandle(__join_all(sep.handle, parts)); }
export function rest_log(rest: FixedArray<anyref>): void { __rest_log(rest); }
export function arr_log(arr: String, args: FixedArray<anyref>): void { __arr_log(arr.handle, args); }
export function describe_flags(flags: Flags, strict: boolean): String { return String.fromHandle(__describe_flags(flags.ref(), strict)); }

// JSPI: suspends on a Promise and returns its value. Importing this
// selects JSPI mode in `embed`, which wraps the provides with promising.
@external("./builtins.js", "await")
export declare function await_(p: externref): externref | null;

