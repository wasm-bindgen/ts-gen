export function stringify(value: externref | null): String { return String.fromHandle(__stringify(value)); }
export function stringify_with_replacer(value: externref | null, replacer: externref): String { return String.fromHandle(__stringify_with_replacer(value, replacer)); }
export function stringify_with_replacer_and_space(value: externref | null, replacer: externref, space: f64): String { return String.fromHandle(__stringify_with_replacer_and_space(value, replacer, space)); }

// JSPI: suspends on a Promise and returns its value. Importing this
// selects JSPI mode in `embed`, which wraps the provides with promising.
@external("./builtins.js", "await")
export declare function await_(p: externref): externref | null;
