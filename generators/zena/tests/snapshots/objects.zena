declare function __search(p0: Search, p1: Streaming, p2: PartialHeaders2): void;

export function __Filter_encode(v: Filter | null): inline (i32, externref | null) {
  if (v == null) { return (0, null); }
  if (v is FilterStr) { return (1, (v as FilterStr).value.handle); }
  if (v is FilterFilterOpMap) { return (2, ((v as FilterFilterOpMap).value as externref)); }
  if (v is FilterCollectionOpMap) { return (3, ((v as FilterCollectionOpMap).value as externref)); }
  return (0, null);
}

export function __Shape_encode(v: Shape | null): inline (i32, externref | null) {
  if (v == null) { return (0, null); }
  if (v is ShapeStr) { return (1, (v as ShapeStr).value.handle); }
  if (v is ShapeShapeObject) { return (2, ((v as ShapeShapeObject).value as externref)); }
  return (0, null);
}

export function __Border_encode(v: Border | null): inline (i32, f64, externref | null) {
  if (v == null) { return (0, 0.0, null); }
  if (v is BorderF64) { return (1, (v as BorderF64).value, null); }
  if (v is BorderBorderColor) { return (2, 0.0, ((v as BorderBorderColor).value as externref)); }
  if (v is BorderBorderTop) { return (3, 0.0, ((v as BorderBorderTop).value as externref)); }
  return (0, 0.0, null);
}

export function __XCustomCostKind_decode(arm: i32, s0: externref | null): XCustomCostKind | null {
  if (arm == 1) { return new XCustomCostKindHeaders2XCustomCostPerToken((s0 as Headers2XCustomCostPerToken)); }
  if (arm == 2) { return new XCustomCostKindHeaders2XCustomCostTotal((s0 as Headers2XCustomCostTotal)); }
  if (arm == 3) { return new XCustomCostKindStr(String.fromHandle(s0 as externref)); }
  return null;
}

export function __str_array_in(a: array<var externref | null>): FixedArray<String> {
  let out = new FixedArray<String>(a.length, '');
  for (var i = 0; i < a.length; i += 1) {
    let e = a[i];
    out[i] = String.fromHandle(e as externref);
  }
  return out;
}

export function __str_array_out(a: FixedArray<String>): array<var externref | null> {
  let out = new FixedArray<externref | null>(a.length, null);
  for (var i = 0; i < a.length; i += 1) {
    let e = a[i];
    out[i] = e.handle;
  }
  return out as array<var externref | null>;
}

export function search(s: Search, t: Streaming, h: PartialHeaders2): void {
  __search(s, t, h);
}
