export function __KVValueKind_encode(v: KVValueKind | null): inline (i32, externref | null) {
  if (v == null) { return (0, null); }
  if (v is KVValueKindStr) { return (1, (v as KVValueKindStr).value.handle); }
  if (v is KVValueKindArrayBuffer) { return (2, ((v as KVValueKindArrayBuffer).value as externref)); }
  return (0, null);
}

export function __NodeChildKind_encode(v: NodeChildKind | null): inline (i32, externref | null) {
  if (v == null) { return (0, null); }
  if (v is NodeChildKindNode) { return (1, ((v as NodeChildKindNode).value as externref)); }
  if (v is NodeChildKindStr) { return (2, (v as NodeChildKindStr).value.handle); }
  return (0, null);
}

@export("tw:call:fn(...arr<Any?>)", "tw")
export function __tw_trampoline(env: anyref, p0_0: FixedArray<externref | null>): void {
  let f = env as (a0: FixedArray<externref | null>) => void;
  let a0: FixedArray<externref | null> = p0_0;
  f(a0);
  __tw_entered();
}

