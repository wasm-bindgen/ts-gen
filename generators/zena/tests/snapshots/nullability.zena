// The arm a `Mode` holds, from `Mode_arm`.
export sealed class Mode_Arm {
  case Mode_Fast
  case Mode_Slow
}
export function Mode_arm(x: Mode): Mode_Arm {
  let __r = x.handle;
  return match (__nullability_kind_Mode(__r)) {
    case 0: new Mode_Fast()
    case 1: new Mode_Slow()
    case _: throw new Error("no arm of Mode")
  };
}

// The arm a `Source` holds, from `Source_arm`.
export sealed class Source_Arm {
  case Source_String(value: String)
  case Source_Registry(value: Registry)
