// sys: wasm-bindgen's JsValue surface. `externref` is JsValue; `null`
// is wasm null, `undefined` the JS value below.
@external("./builtins.js", "undefined")
declare let __undefined: externref;
export let Undefined: externref = __undefined;
export function isUndefined(x: externref | null): boolean { return __JsValue_is_undefined(x); }
export function isEmpty(x: externref | null): boolean { return x == null || __JsValue_is_undefined(x); }
export function numberValue(x: externref): f64 { return __Number_value(x); }

// kind Mode: Fast = "fast", Slow = "slow"
export type Mode = String;

// kind Source: String = String, Registry = Registry
export type Source = externref;

// kind KeyKind: String = String, F64 = Number
export type KeyKind = externref;

