@export("tw:call:fn(Str)->{U}", "tw")
export function __tw_trampoline<U>(env: anyref, p0_0: externref): U {
  let f = env as (a0: externref) => U;
  let a0: externref = p0_0;
  let result: U = f(a0);
  __tw_entered();
  return result;
}

@export("tw:call:fn(f64)->{U}", "tw")
export function __tw_trampoline2<U>(env: anyref, p0_0: f64): U {
  let f = env as (a0: f64) => U;
  let a0: f64 = p0_0;
  let result: U = f(a0);
  __tw_entered();
  return result;
}

export function __str_array_out(a: FixedArray<String>): array<var externref | null> {
  let out = new FixedArray<externref | null>(a.length, null);
  for (var i = 0; i < a.length; i += 1) {
    let e = a[i];
    out[i] = e.handle;
  }
  return out as array<var externref | null>;
}

export function __Intl_LocalesArgument_encode(v: Intl_LocalesArgument | null): inline (i32, externref | null, array<var externref | null> | null) {
  if (v == null) { return (0, null, null); }
  if (v is Intl_LocalesArgumentStr) { return (1, (v as Intl_LocalesArgumentStr).value.handle, null); }
  if (v is Intl_LocalesArgumentStrArray) { return (2, null, __str_array_out((v as Intl_LocalesArgumentStrArray).value)); }
  return (0, null, null);
}

export function __SignalOrHalt_decode(arm: i32, s0: externref | null): SignalOrHalt | null {
  if (arm == 1) { return new SignalOrHaltSignal((s0 as Signal)); }
  if (arm == 2) { return new SignalOrHaltHalt((s0 as Halt)); }
  return null;
}

@export("tw:call:fn(SignalOrHalt)", "tw")
export function __tw_trampoline3(env: anyref, p0_0: i32, p0_1: externref | null): void {
  let f = env as (a0: SignalOrHalt) => void;
  let a0: SignalOrHalt = (__SignalOrHalt_decode(p0_0, p0_1) as SignalOrHalt);
  f(a0);
  __tw_entered();
}

