// sys: wasm-bindgen's JsValue surface. `externref` is JsValue; `null`
// is wasm null, `undefined` the JS value below.
@external("./builtins.js", "undefined")
declare let __undefined: externref;
export let Undefined: externref = __undefined;
export function isUndefined(x: externref | null): boolean { return __JsValue_is_undefined(x); }
export function isEmpty(x: externref | null): boolean { return x == null || __JsValue_is_undefined(x); }
export function numberValue(x: externref): f64 { return __Number_value(x); }

// kind Unit: Hour = "hour", Minute = "minute", Second = "second"
export type Unit = String;

// kind Minute: Minute = "minute"
export type Minute = String;

// kind OptionKey: Name = "name", Size = "size", Fixed = "fixed"
export type OptionKey = String;

// kind NotMinute: Hour = "hour", Second = "second"
export type NotMinute = String;

// kind Plural: Hour = "hour", Minute = "minute", Second = "second", Hours = "hours", Minutes = "minutes", Seconds = "seconds"
export type Plural = String;

// kind Scoped.Mode: Fast = "fast", Slow = "slow"
export type Scoped_Mode = String;

// kind Scoped.NotFast: Slow = "slow"
export type Scoped_NotFast = String;

// kind ExcludeUnitHour: Minute = "minute", Second = "second"
export type ExcludeUnitHour = String;

// kind ExtractUnitOrDayUnit: Hour = "hour", Minute = "minute", Second = "second"
export type ExtractUnitOrDayUnit = String;

// kind PluralHourOrMinute: Hour = "hour", Minute = "minute", Hours = "hours", Minutes = "minutes"
export type PluralHourOrMinute = String;

// kind KeyOfExtended: Extra = "extra", Name = "name", Size = "size", Fixed = "fixed"
export type KeyOfExtended = String;

// kind LargestUnitKind: Auto = "auto", Hour = "hour", Minute = "minute", Second = "second", Hours = "hours", Minutes = "minutes", Seconds = "seconds"
export type LargestUnitKind = String;

// The arm a `Unit` holds, from `Unit_arm`.
export sealed class Unit_Arm {
  case Unit_Hour
  case Unit_Minute
  case Unit_Second
}
export function Unit_arm(x: Unit): Unit_Arm {
  let __r = x.handle;
  return match (__type_eval_kind_Unit(__r)) {
    case 0: new Unit_Hour()
    case 1: new Unit_Minute()
    case 2: new Unit_Second()
    case _: throw new Error("no arm of Unit")
  };
}

// The arm a `Minute` holds, from `Minute_arm`.
export sealed class Minute_Arm {
  case Minute_Minute
}
export function Minute_arm(x: Minute): Minute_Arm {
  let __r = x.handle;
  return match (__type_eval_kind_Minute(__r)) {
    case 0: new Minute_Minute()
    case _: throw new Error("no arm of Minute")
  };
}

// The arm a `OptionKey` holds, from `OptionKey_arm`.
