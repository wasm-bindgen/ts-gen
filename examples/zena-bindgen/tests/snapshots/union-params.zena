  if (v is TaggedStream) { return (2, ((v as TaggedStream).value as externref)); }
  return (0, null);
}

export function __VKind_encode(v: VKind | null): inline (i32, externref | null, f64) {
  if (v == null) { return (0, null, 0.0); }
  if (v is VKindStr) { return (1, (v as VKindStr).value.handle, 0.0); }
  if (v is VKindF64) { return (2, null, (v as VKindF64).value); }
  return (0, null, 0.0);
}

export function __ValueKind_encode(v: ValueKind | null): inline (i32, externref | null, array<var u8> | null) {
  if (v == null) { return (0, null, null); }
  if (v is ValueKindStr) { return (1, (v as ValueKindStr).value.handle, null); }
  if (v is ValueKindBuffer) { return (2, null, ((v as ValueKindBuffer).value as array<var u8>)); }
  return (0, null, null);
}

export function __ValueKind2_encode(v: ValueKind2 | null): inline (i32, externref | null, array<var u8> | null) {
  if (v == null) { return (0, null, null); }
  if (v is ValueKind2Blob) { return (1, ((v as ValueKind2Blob).value as externref), null); }
  if (v is ValueKind2Buffer) { return (2, null, ((v as ValueKind2Buffer).value as array<var u8>)); }
  if (v is ValueKind2Str) { return (3, (v as ValueKind2Str).value.handle, null); }
  return (0, null, null);
}

export function __BufferSource_decode(arm: i32, s0: externref | null): BufferSource | null {
  if (arm == 1) { return new BufferSourceArrayBuffer((s0 as ArrayBuffer)); }
  if (arm == 2) { return new BufferSourceArrayBufferView((s0 as ArrayBufferView)); }
  return null;
}

export function __Body_decode(arm: i32, s0: externref | null): Body | null {
  if (arm == 1) { return new BodyStr(String.fromHandle(s0 as externref)); }
  if (arm == 2) { return new BodyBlob((s0 as Blob)); }
  if (arm == 3) { return new BodyStream((s0 as Stream)); }
  return null;
}

export function send(body: Body): void {
  let (t8, t9) = __Body_encode(body);
  __send(t8, t9);
}

export function sendMaybe(): void {
  __sendMaybe();
}

export function sendMaybeWithBody(body: Body): void {
  let (t10, t11) = __Body_encode(body);
  __sendMaybe2(t10, t11);
}

export function sendAny(body: BodyKind): void {
  let (t12, t13) = __BodyKind_encode(body);
  __sendAny(t12, t13);
}

export function sendPiece(piece: Piece): void {
  let (t14, t15) = __Piece_encode(piece);
  __sendPiece(t14, t15);
}

export function sendPayload(body: Body): void {
  let (t16, t17) = __Body_encode(body);
  __sendPayload(t16, t17);
}

export function sendLoose(body: Body): void {
  let (t18, t19) = __Body_encode(body);
  __sendLoose(t18, t19);
}

export function wrapDefault(w: Wrapped): void {
  let (t20, t21) = __Wrapped_encode(w);
  __wrapDefault(t20, t21);
}

export function wrapBlob(w: WrappedBlob): void {
  let (t22, t23) = __WrappedBlob_encode(w);
  __wrapBlob(t22, t23);
}

export function tagged(t: Tagged): void {
  let (t24, t25) = __Tagged_encode(t);
  __tagged(t24, t25);
}

export function scalar(v: VKind | null): void {
  let (t26, t27, t28) = __VKind_encode(v);
  __scalar(t26, t27, t28);
}

export function configure(s: Universal): void {
  __configure(s);
}

export function digest(data: FixedArray<u8>): ArrayBuffer {
  return __digest(data);
}

export function store(key: String, value: ValueKind): void {
  let (t29, t30, t31) = __ValueKind_encode(value);
  __store(key, t29, t30, t31);
}

export function storeBlob(value: ValueKind2): void {
  let (t32, t33, t34) = __ValueKind2_encode(value);
  __storeBlob(t32, t33, t34);
}

export function load(): FixedArray<u8> | null {
  return __load();
}

export function loadText(): BufferOrStr {
  let (r0, r1, r2) = __loadText();
  return (__BufferOrStr_decode(r0, r1, r2) as BufferOrStr);
}

// skipped join(arr<buffer>): a future of `buffer`, which is converted
export function boxed(): Box<BufferSourceBox> {
  return __boxed();
}

/**
 * * `data`
 */
export function hash(data: FixedArray<u8>): void {
  __hash(data);
}

// skipped hash(*buffer): `*buffer` needs a linear memory
/**
 * * `data`
 */
export function hashText(data: String): void {
  __hashText(data);
}

/**
 * * `data`
 */
