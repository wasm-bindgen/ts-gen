export function __MessageEventOrCloseEvent_decode(arm: i32, s0: externref | null): MessageEventOrCloseEvent | null {
  if (arm == 1) { return new MessageEventOrCloseEventMessageEvent((s0 as MessageEvent)); }
  if (arm == 2) { return new MessageEventOrCloseEventCloseEvent((s0 as CloseEvent)); }
  return null;
}

@export("tw:call:fn(Str)->{U}", "tw")
