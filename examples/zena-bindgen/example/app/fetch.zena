// Subrequests: a service binding, the global fetch, and giving up on one.
import { Future, TaskGroup } from 'zena:async';
import {
  AbortController, BodyInitStr, Env, Event, EventListenerOrEventListenerObjectEventListener, NoStoreOrNoCache,
  RequestInfoStr, RequestInit, RequestInitCfProperties, Response, fetchWithInit, scheduler
} from '../bindings.zena';
import { ok } from './reply.zena';

async function slow(env: Env): Future<String> {
  return await (await env.HELPER.fetch(new RequestInfoStr("http://helper/slow"))).text();
}

async function giveUp(ms: f64): Future<String> {
  await scheduler().wait(ms);
  return "gave up after 20ms, which cancelled the fetch";
}

/** `/fetch`: the helper service through its binding and through `fetch`. */
export async function fetchRoute(env: Env): Future<Response> {
  let bound = await (await env.HELPER.fetch(new RequestInfoStr("http://helper/notes"))).text();
  // The options object: a method, a body, and a literal enum.
  let init = new RequestInit<RequestInitCfProperties>();
  init.setMethod("POST");
  init.body = new BodyInitStr("ping");
  init.setCache(NoStoreOrNoCache.NoStore);
  let global = await (await fetchWithInit(new RequestInfoStr("http://helper/echo"), init)).text();
  // Whichever finishes first wins, and the other is cancelled.
  let tasks = new Array<() => Future<String>>();
  tasks.push(() => slow(env));
  tasks.push(() => giveUp(20.0));
  let race = await TaskGroup.race<String>(tasks);
  // Cancelling goes through an AbortController the bridge makes for the
  // call. One made here works too: JS calls the listener on `abort()`.
  let controller = new AbortController();
  var heard = "nothing";
  let listener = new EventListenerOrEventListenerObjectEventListener((event: Event): void => {
    heard = `an "${event.type_}" event`;
  });
  controller.signal.addEventListener("abort", listener);
  controller.abort();
  return ok(`service binding: ${bound}global fetch: ${global}race: ${race}\n` +
    `AbortController: the listener heard ${heard}, signal.aborted is ${controller.signal.aborted}\n`);
}
