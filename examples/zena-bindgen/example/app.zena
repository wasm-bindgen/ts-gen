// The worker: a router over the tour's routes, one topic per file in
// app/, and the other things the module exports.
import { Future } from 'zena:async';
import { Env, MessageBatch, RequestInfoStr, Response, ScheduledController, StrOrURLStr, URL } from './bindings.zena';
import { Ctx, Req, note, ok, reply } from './app/reply.zena';
import { echo, form, json, url } from './app/http.zena';
import { crypto_ } from './app/crypto.zena';
import { stream } from './app/streams.zena';
import { fetchRoute } from './app/fetch.zena';
import { timers } from './app/timers.zena';
import { rewrite } from './app/rewrite.zena';
import { cache } from './app/cache.zena';
import { counter, rpc } from './app/durable.zena';
import { ws } from './app/ws.zena';
import { fail, failPlain, failTyped } from './app/fail.zena';

export { Counter, Greeter } from './app/durable.zena';
export { Room } from './app/ws.zena';

let routes = "/echo /url /form /json /crypto /stream /timers /fetch /rewrite /cache " +
  "/counter/kv /counter/transaction /counter/sql /counter/alarm /ws /rpc " +
  "/fail /fail/typed /fail/plain /scheduled /queue";

/** The default export's `fetch`. */
export async function fetch(request: Req, env: Env, ctx: Ctx): Future<Response> {
  let path = new URL(new StrOrURLStr(request.url)).pathname;
  if (path.startsWith("/counter/")) {
    return await counter(request, env);
  }
  return match (path) {
    case "/": ok(`${env.GREETING}. The routes:\n${routes.replaceAll(" ", "\n")}\n`)
    case "/echo": await echo(request)
    case "/url": url(request)
    case "/form": await form(request)
    case "/json": await json(request)
    case "/crypto": await crypto_()
    case "/stream": await stream()
    case "/fetch": await fetchRoute(env)
    case "/timers": await timers(env, ctx)
    case "/rewrite": await rewrite()
    case "/cache": await cache()
    case "/ws": await ws(env)
    case "/rpc": await rpc(env)
    case "/fail": await fail(env)
    case "/fail/typed": failTyped()
    case "/fail/plain": failPlain()
    // The helper calls the worker's `scheduled` and `queue` handlers.
    case "/scheduled": await env.HELPER.fetch(new RequestInfoStr("http://helper/scheduled"))
    case "/queue": await env.HELPER.fetch(new RequestInfoStr("http://helper/queue"))
    case _: reply(404 as u16, `no route ${path}\n`)
  };
}

/** The default export's `scheduled`: the helper triggers it for `/scheduled`. */
export async function scheduled(controller: ScheduledController, env: Env, ctx: Ctx): Future<void> {
  await note(env, `scheduled ran for the cron ${controller.cron}`);
}

/** The default export's `queue`: the helper delivers a batch for `/queue`. */
export async function queue(batch: MessageBatch<externref | null>, env: Env, ctx: Ctx): Future<void> {
  var bodies = "";
  for (let message in batch.messages) {
    // A message's body is any JS value: these are strings.
    bodies = bodies + " " + String.fromHandle(message.body as externref);
    message.ack();
  }
  await note(env, `queue "${batch.queue}" delivered ${batch.messages.length} messages:${bodies}`);
}
