ir 1;

enum ProbeError extends err {
  @js(RangeError) Busy(Str);
}

enum Mode {
  @js("off") Off;
  Count(u32);
}

namespace ext {
  none(): Str?;
  apply(f: fn(u32) -> u32, x: u32): u32;
  seen(v: Str?);
  seenNull(v: @js(null) Str?);
  later(f: fn(u32) -> future<u32>, x: u32): future<u32>;
  settle(p: future<str>): future<str>;
  bytes(v: u8[]): u8[];
  words(xs: arr<str>): arr<str>;
  @js(args = (sep, ...parts))
  join(sep: str, parts: arr<str>): str;
  pick<This = Any?>(x: u32): u32;
  soon(f: fn());
}

export class Counter {
  new();
  get n(): u32;
}

export namespace probe {
  split(n: u32): (u32, bool);
  check(n: u32): u32 throws ProbeError;
  settle(ok: bool): future<str, ProbeError>;
  absent(v: Str?): bool;
  imported(): bool;
  counter(): Any;
  count(v: Any): u32;
  mode(n: u32): Any;
  modeOf(v: Any): u32;
  adder(): Any;
  callBoxed(f: Any, x: u32): u32;
  none(): Str?;
  writeNones();
  asyncCallback(x: u32): future<u32>;
  made(): future<str>;
  bytes(): u32;
  words(): str;
  join(): str;
  soon(): future<str>;
}
