  ;; The benchmark runtime: the test runtime's exports over a bump allocator
  ;; with no poisoning, whose `free` does nothing. `bench:reset` rewinds the
  ;; bump to its `bench:mark`, between batches.
  (memory (export "memory") {MEM} 1)
  (table $tab (export "tw:table") 132 externref)
  (global (export "tw:table/stack_base") i32 (i32.const 1))
  (global (export "tw:table/const_base") i32 (i32.const 128))
  (global (export "tw:table/heap_base") i32 (i32.const 132))
  (global $bump (mut {P}) ({P}.const 16))
  (global $mark (mut {P}) ({P}.const 16))
  (global $tbump (mut i32) (i32.const 132))
  (global $tmark (mut i32) (i32.const 132))
  (func $alloc (param $align {P}) (param $size {P}) (result {P})
    (local $p {P}) (local $end {P}) (local $have {P})
    (local.set $p ({P}.and ({P}.add (global.get $bump) ({P}.sub (local.get $align) ({P}.const 1))) ({P}.sub ({P}.const 0) (local.get $align))))
    (local.set $end ({P}.add (local.get $p) (local.get $size)))
    (local.set $have ({P}.shl (memory.size) ({P}.const 16)))
    (if ({P}.gt_u (local.get $end) (local.get $have))
      (then (drop (memory.grow ({P}.shr_u ({P}.add ({P}.sub (local.get $end) (local.get $have)) ({P}.const 65535)) ({P}.const 16))))))
    (global.set $bump (local.get $end))
    (local.get $p))
  (func $realloc (export "tw:realloc") (param $old {P}) (param $osize {P}) (param $align {P}) (param $size {P}) (result {P})
    (local $p {P})
    (if ({P}.eqz (local.get $old)) (then (return (call $alloc (local.get $align) (local.get $size)))))
    ;; Shrinking in place is what a real allocator does for the bridge's
    ;; over-allocated UTF-8 buffers.
    (if ({P}.le_u (local.get $size) (local.get $osize)) (then (return (local.get $old))))
    (local.set $p (call $alloc (local.get $align) (local.get $size)))
    (memory.copy (local.get $p) (local.get $old) (local.get $osize))
    (local.get $p))
  (func $free (export "tw:free") (param $p {P}) (param $size {P}) (param $align {P}))
  (func (export "tw:table/alloc") (param $n i32) (result i32)
    (local $b i32)
    (local.set $b (global.get $tbump))
    (global.set $tbump (i32.add (local.get $b) (local.get $n)))
    (if (i32.gt_u (global.get $tbump) (table.size $tab))
      (then (drop (table.grow $tab (ref.null extern) (i32.sub (global.get $tbump) (table.size $tab))))))
    (local.get $b))
  (func (export "tw:table/free") (param $b i32) (param $n i32))
  (func (export "test:alloc") (param $align {P}) (param $size {P}) (result {P})
    (call $alloc (local.get $align) (local.get $size)))
  (func (export "test:live") (result i32) (i32.const 0))
  (func (export "test:bytes") (result {P}) ({P}.const 0))
  (func (export "test:tlive") (result i32) (i32.const 0))
  (func (export "bench:mark") (global.set $mark (global.get $bump)) (global.set $tmark (global.get $tbump)))
  (func (export "bench:reset")
    (table.fill $tab (global.get $tmark) (ref.null extern) (i32.sub (global.get $tbump) (global.get $tmark)))
    (global.set $bump (global.get $mark)) (global.set $tbump (global.get $tmark)))
