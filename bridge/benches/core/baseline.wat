;; The floor: the same call shapes imported straight from JS, no bridge.
(module
  (import "b" "noop" (func $noop (param externref)))
  (import "b" "id" (func $id (param externref i32) (result i32)))
  (import "b" "idcall" (func $idcall (param externref i32) (result i32)))
  (import "b" "put" (func $put (param externref externref externref)))
  (import "b" "pair" (func $pair (param externref) (result i32 f64)))
  (import "b" "cb" (func $cb (param i32 i32) (result i32)))
  (func (export "id") (param i32) (result i32) (local.get 0))
  (func (export "cbExport") (param i32 i32) (result i32) (call $cb (local.get 0) (local.get 1)))
  (func (export "loop:noop") (param $n i32) (param externref) (local $i i32)
    (block $b (loop $l (br_if $b (i32.ge_u (local.get $i) (local.get $n)))
      (call $noop (local.get 1))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l))))
  (func (export "loop:id") (param $n i32) (param externref i32) (local $i i32)
    (block $b (loop $l (br_if $b (i32.ge_u (local.get $i) (local.get $n)))
      (drop (call $id (local.get 1) (local.get 2)))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l))))
  (func (export "loop:idcall") (param $n i32) (param externref i32) (local $i i32)
    (block $b (loop $l (br_if $b (i32.ge_u (local.get $i) (local.get $n)))
      (drop (call $idcall (local.get 1) (local.get 2)))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l))))
  (func (export "loop:put") (param $n i32) (param externref externref externref) (local $i i32)
    (block $b (loop $l (br_if $b (i32.ge_u (local.get $i) (local.get $n)))
      (call $put (local.get 1) (local.get 2) (local.get 3))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l))))
  (func (export "loop:pair") (param $n i32) (param externref) (local $i i32)
    (block $b (loop $l (br_if $b (i32.ge_u (local.get $i) (local.get $n)))
      (call $pair (local.get 1)) (drop) (drop)
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l))))
)
