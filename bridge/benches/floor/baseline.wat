;; Engine floors for result conventions between JS and Wasm.
(module
  (import "b" "one" (func $one (result i32)))
  (import "b" "two" (func $two (result i32 i32)))
  (import "b" "pairf" (func $pairf (result i32 f64)))
  (import "b" "viaMem" (func $viaMem (result i32)))
  (import "b" "viaGlobal" (func $viaGlobal (result i32)))
  (import "b" "f64nan" (func $f64nan (result f64)))
  (import "b" "i64r" (func $i64r (result i64)))
  (import "b" "i64pack" (func $i64pack (result i64)))
  (import "b" "viaMemLen" (func $viaMemLen (result i32)))
  (import "b" "f64pack" (func $f64pack (result f64)))
  (global $g (export "g") (mut f64) (f64.const 0))
  (memory (export "mem") 2)
  (func (export "loop:one") (param $n i32) (local $i i32)
    (block $b (loop $l (br_if $b (i32.ge_u (local.get $i) (local.get $n)))
      (drop (call $one)) (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l))))
  (func (export "loop:two") (param $n i32) (local $i i32)
    (block $b (loop $l (br_if $b (i32.ge_u (local.get $i) (local.get $n)))
      (call $two) (drop) (drop) (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l))))
  (func (export "loop:pairf") (param $n i32) (local $i i32)
    (block $b (loop $l (br_if $b (i32.ge_u (local.get $i) (local.get $n)))
      (call $pairf) (drop) (drop) (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l))))
  (func (export "loop:viaMem") (param $n i32) (local $i i32)
    (block $b (loop $l (br_if $b (i32.ge_u (local.get $i) (local.get $n)))
      (drop (call $viaMem)) (drop (f64.load (i32.const 8)))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l))))
  (func (export "loop:viaGlobal") (param $n i32) (local $i i32)
    (block $b (loop $l (br_if $b (i32.ge_u (local.get $i) (local.get $n)))
      (drop (call $viaGlobal)) (drop (global.get $g))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l))))
  (func (export "loop:f64nan") (param $n i32) (local $i i32)
    (block $b (loop $l (br_if $b (i32.ge_u (local.get $i) (local.get $n)))
      (drop (call $f64nan)) (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l))))
  (func (export "loop:i64r") (param $n i32) (local $i i32)
    (block $b (loop $l (br_if $b (i32.ge_u (local.get $i) (local.get $n)))
      (drop (call $i64r)) (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l))))

  (func (export "loop:i64pack") (param $n i32) (local $i i32)
    (block $b (loop $l (br_if $b (i32.ge_u (local.get $i) (local.get $n)))
      (drop (call $i64pack)) (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l))))
  (func (export "loop:viaMemLen") (param $n i32) (local $i i32)
    (block $b (loop $l (br_if $b (i32.ge_u (local.get $i) (local.get $n)))
      (drop (call $viaMemLen)) (drop (f64.load (i32.const 8)))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l))))
  (func (export "loop:f64pack") (param $n i32) (local $i i32)
    (block $b (loop $l (br_if $b (i32.ge_u (local.get $i) (local.get $n)))
      (drop (call $f64pack)) (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l))))
;; A Wasm export with a multi-value result, called from JS.
  (func (export "pair2") (param $v i32) (result i32 f64) (local.get $v) (f64.const 2.5))
  (func (export "one2") (param $v i32) (result i32) (local.get $v))
  ;; GC (array i8) <-> memory copy kernels, 64K bytes at 1024.
  (type $a8 (array (mut i8)))
  (global $arr (mut (ref null $a8)) (ref.null $a8))
  (func (export "mk") (param $n i32) (global.set $arr (array.new $a8 (i32.const 7) (local.get $n))))
  (func (export "ser1") (local $a (ref null $a8)) (local $i i32) (local $n i32)
    (local.set $a (global.get $arr)) (local.set $n (array.len (local.get $a)))
    (block $b (loop $l (br_if $b (i32.ge_u (local.get $i) (local.get $n)))
      (i32.store8 offset=1024 (local.get $i) (array.get_u $a8 (local.get $a) (local.get $i)))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l))))
  (func (export "ser4") (local $a (ref $a8)) (local $i i32) (local $n i32) (local $n4 i32)
    (local.set $a (ref.as_non_null (global.get $arr))) (local.set $n (array.len (local.get $a)))
    (local.set $n4 (i32.and (local.get $n) (i32.const -4)))
    (block $b (loop $l (br_if $b (i32.ge_u (local.get $i) (local.get $n4)))
      (i32.store offset=1024 (local.get $i)
        (i32.or (i32.or (array.get_u $a8 (local.get $a) (local.get $i))
                        (i32.shl (array.get_u $a8 (local.get $a) (i32.add (local.get $i) (i32.const 1))) (i32.const 8)))
                (i32.or (i32.shl (array.get_u $a8 (local.get $a) (i32.add (local.get $i) (i32.const 2))) (i32.const 16))
                        (i32.shl (array.get_u $a8 (local.get $a) (i32.add (local.get $i) (i32.const 3))) (i32.const 24)))))
      (local.set $i (i32.add (local.get $i) (i32.const 4))) (br $l)))
    (block $b (loop $l (br_if $b (i32.ge_u (local.get $i) (local.get $n)))
      (i32.store8 offset=1024 (local.get $i) (array.get_u $a8 (local.get $a) (local.get $i)))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l))))
  (func (export "de1") (param $n i32) (local $a (ref null $a8)) (local $i i32)
    (local.set $a (array.new_default $a8 (local.get $n)))
    (block $b (loop $l (br_if $b (i32.ge_u (local.get $i) (local.get $n)))
      (array.set $a8 (local.get $a) (local.get $i) (i32.load8_u offset=1024 (local.get $i)))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
    (global.set $arr (local.get $a)))
  (func (export "de4") (param $n i32) (local $a (ref $a8)) (local $i i32) (local $n4 i32) (local $w i32)
    (local.set $a (array.new_default $a8 (local.get $n)))
    (local.set $n4 (i32.and (local.get $n) (i32.const -4)))
    (block $b (loop $l (br_if $b (i32.ge_u (local.get $i) (local.get $n4)))
      (local.set $w (i32.load offset=1024 (local.get $i)))
      (array.set $a8 (local.get $a) (local.get $i) (local.get $w))
      (array.set $a8 (local.get $a) (i32.add (local.get $i) (i32.const 1)) (i32.shr_u (local.get $w) (i32.const 8)))
      (array.set $a8 (local.get $a) (i32.add (local.get $i) (i32.const 2)) (i32.shr_u (local.get $w) (i32.const 16)))
      (array.set $a8 (local.get $a) (i32.add (local.get $i) (i32.const 3)) (i32.shr_u (local.get $w) (i32.const 24)))
      (local.set $i (i32.add (local.get $i) (i32.const 4))) (br $l)))
    (block $b (loop $l (br_if $b (i32.ge_u (local.get $i) (local.get $n)))
      (array.set $a8 (local.get $a) (local.get $i) (i32.load8_u offset=1024 (local.get $i)))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l)))
    (global.set $arr (local.get $a)))
)
