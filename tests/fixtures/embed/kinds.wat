;; Each provide returns the arm index a kind's discriminator reports for
;; its argument, taken as externref or anyref.
(module
  (import "./bindings.wasm" "kind:HeadersKind" (func $headers (param externref) (result i32)))
  (import "./bindings.wasm" "kind:Method" (func $method (param anyref) (result i32)))
  (import "./bindings.wasm" "kind:Level" (func $level (param (ref extern)) (result i32)))
  (import "./bindings.wasm" "kind:MixedReturnKind" (func $mixed (param externref) (result i32)))
  (import "./bindings.wasm" "kind:ListsReturnKind" (func $lists (param externref) (result i32)))
  (import "./bindings.wasm" "kind:NestedReturnKind" (func $nested (param externref) (result i32)))
  (import "./bindings.wasm" "kind:ThingsReturnKind" (func $things (param externref) (result i32)))
  (import "embed:kinds" "kind:Shade" (func $shade (param externref) (result i32)))

  (func (export "headers") (param $x externref) (result f64)
    (f64.convert_i32_s (call $headers (local.get $x))))
  (func (export "method") (param $x externref) (result f64)
    (f64.convert_i32_s (call $method (any.convert_extern (local.get $x)))))
  (func (export "level") (param $x externref) (result f64)
    (f64.convert_i32_s (call $level (ref.as_non_null (local.get $x)))))
  (func (export "mixed") (param $x externref) (result f64)
    (f64.convert_i32_s (call $mixed (local.get $x))))
  (func (export "lists") (param $x externref) (result f64)
    (f64.convert_i32_s (call $lists (local.get $x))))
  (func (export "nested") (param $x externref) (result f64)
    (f64.convert_i32_s (call $nested (local.get $x))))
  (func (export "things") (param $x externref) (result f64)
    (f64.convert_i32_s (call $things (local.get $x))))
  (func (export "shade") (param $x externref) (result f64)
    (f64.convert_i32_s (call $shade (local.get $x))))
)
