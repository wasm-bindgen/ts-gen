ir 1;

module "nullability" {
  shape class Settings {
    new {};
    get plain?: String | Undefined;
    set plain(value: String) as set_plain;
    get explicit?: String | Undefined;
    set explicit(value: String) as set_explicit;
    get required: String | Undefined;
    set required(value: String) as set_required;
    get nullable: String | Null;
    set nullable(value: String) as set_nullable;
    set nullable(value: Null) as set_nullable_with_null;
    get both?: String | Null | Undefined;
    set both(value: String) as set_both;
    set both(value: Null) as set_both_with_null;
    get aliased?: String | Null | Undefined;
    set aliased(value: String) as set_aliased;
    set aliased(value: Null) as set_aliased_with_null;
    get mode?: Mode | Null | Undefined;
    set mode(value: Mode) as set_mode;
    set mode(value: Null) as set_mode_with_null;
    get empties: Null | Undefined;
    set empties(value: Null) as set_empties_with_null;
    get limit?: Number | Null | Undefined;
    set limit(value: f64) as set_limit;
    set limit(value: Null) as set_limit_with_null;
    get owner?: Registry | Null | Undefined;
    set owner(value: Registry) as set_owner;
    set owner(value: Null) as set_owner_with_null;
    get values?: Array<Number> | Null | Undefined;
    set values(value: Array<Number>) as set_values;
    set values(value: Null) as set_values_with_null;
    get key?: KeyKind | Null | Undefined;
    set key(value: String) as set_key;
    set key(value: f64) as set_key_with_f64;
    set key(value: Null) as set_key_with_null;
  }

  class Registry {
    static get current?: Registry | Undefined;
    static set current(value: Registry) as set_current;
    static get fallback: Registry | Null;
    static set fallback(value: Registry) as set_fallback;
    static set fallback(value: Null) as set_fallback_with_null;
    static get last?: Registry | Null | Undefined;
    static set last(value: Registry) as set_last;
    static set last(value: Null) as set_last_with_null;
    get pending: Promise<String | Null>;
    get settled: Promise<Number | Undefined>;
  }

  class Holder<T> {
    get(): T | Null | Undefined;
    get value: T | Null | Undefined;
  }

  class Body {
    new(body: String) throws;
    new(body: Null) throws as new_with_body_null;
    new(body: String, length: f64) throws as new_with_length;
    new(body: Null, length: f64) throws as new_with_body_null_and_length;
    new(body: String, length: Null) throws as new_with_length_null;
    new(body: Null, length: Null) throws as new_with_body_null_and_length_null;
    put(value: String);
    put(value: Null) as put_with_null;
    static from(owner: Registry): Body;
    static from(owner: Null): Body as from_with_null;
  }

  shape class Attachment {
    new {};
    get disposition: DispositionKind;
    set disposition(value: DispositionKind) as set_disposition;
    get contentId?: String | Undefined as content_id;
    set contentId(value: String) as set_content_id;
    get filename: String;
    set filename(value: String) as set_filename;
  }

  shape class Upload {
    new {};
    get kind: KindKind;
    set kind(value: KindKind) as set_kind;
    get path?: String | Null | Undefined;
    set path(value: String) as set_path;
    set path(value: Null) as set_path_with_null;
  }

  shape class Cover {
    new {};
    get kind: CoverKindKind;
    set kind(value: CoverKindKind) as set_kind;
    get src: String | Null;
    set src(value: String) as set_src;
    set src(value: Null) as set_src_with_null;
  }

  kind Mode {
    Fast = "fast";
    Slow = "slow";
  }

  kind Source {
    String = String;
    Registry = Registry;
  }
}

kind KeyKind {
  String = String;
  F64 = Number;
}

kind DispositionKind {
  Inline = "inline";
  Attachment = "attachment";
}

kind KindKind {
  File = "file";
  None = "none";
  Skip = "skip";
}

kind CoverKindKind {
  Image = "image";
  Blank = "blank";
}

module "nullability" {
  function optional();
  function optional(x: String) as optional_with_x;
  function nullable(x: String);
  function nullable(x: Null) as nullable_with_null;
  function both(): String | Null | Undefined;
  function both(x: String): String | Null | Undefined as both_with_x;
  function both(x: Null): String | Null | Undefined as both_with_null;
  function optionalBoth() as optional_both;
  function optionalBoth(x: String) as optional_both_with_x;
  function optionalBoth(x: Null) as optional_both_with_null;
  function aliased(): String | Null | Undefined;
  function aliased(x: String): String | Null | Undefined as aliased_with_x;
  function aliased(x: Null): String | Null | Undefined as aliased_with_null;
  function aliasedNull(x: String): String | Null as aliased_null;
  function aliasedNull(x: Null): String | Null as aliased_null_with_null;
  function optAliasedNull(): String | Null | Undefined as opt_aliased_null;
  function optAliasedNull(x: String): String | Null | Undefined as opt_aliased_null_with_x;
  function optAliasedNull(x: Null): String | Null | Undefined as opt_aliased_null_with_null;
  function count(): Number | Null | Undefined;
  function count(x: f64): Number | Null | Undefined as count_with_x;
  function count(x: Null): Number | Null | Undefined as count_with_null;
  function countNull(x: f64) as count_null;
  function countNull(x: Null) as count_null_with_null;
  function countOptional() as count_optional;
  function countOptional(x: f64) as count_optional_with_x;
  function countOptional(x: Null) as count_optional_with_null;
  function flag(x: bool): Boolean | Null;
  function flag(x: Null): Boolean | Null as flag_with_null;
  function registry(): Registry | Null | Undefined;
  function registry(r: Registry): Registry | Null | Undefined as registry_with_r;
  function registry(r: Null): Registry | Null | Undefined as registry_with_null;
  function registryNull(r: Registry) as registry_null;
  function registryNull(r: Null) as registry_null_with_null;
  function registryOptional() as registry_optional;
  function registryOptional(r: Registry) as registry_optional_with_r;
  function registryOptional(r: Null) as registry_optional_with_null;
  function scalar();
  function scalar(x: String) as scalar_with_str;
  function scalar(x: f64) as scalar_with_f64;
  function scalar(x: Null) as scalar_with_null;
  function scalarNull(x: String) as scalar_null;
  function scalarNull(x: f64) as scalar_null_with_f64;
  function scalarNull(x: Null) as scalar_null_with_null;
  function scalarOptional() as scalar_optional;
  function scalarOptional(x: String) as scalar_optional_with_str;
  function scalarOptional(x: f64) as scalar_optional_with_f64;
  function scalarOptional(x: Null) as scalar_optional_with_null;
  function pair(x: String);
  function pair(x: f64) as pair_with_f64;
  function leading(a: String | Undefined, b: f64);
  function leadingNull(a: String | Undefined, b: f64) as leading_null;
  function leadingNull(a: Null, b: f64) as leading_null_with_null;
  function trailing(a: f64);
  function trailing(a: f64, b: String) as trailing_with_b;
  function chain();
  function chain(a: String) as chain_with_a;
  function chain(a: String | Undefined, b: f64) as chain_with_a_and_b;
  function chain(a: String | Undefined, b: Null) as chain_with_a_and_null;
  function chainOptional() as chain_optional;
  function chainOptional(a: String) as chain_optional_with_a;
  function chainOptional(a: String | Undefined, b: f64) as chain_optional_with_a_and_b;
  function chainOptional(a: String | Undefined, b: Null) as chain_optional_with_a_and_null;
  function chainThree() as chain_three;
  function chainThree(a: String) as chain_three_with_a;
  function chainThree(a: String | Undefined, b: f64) as chain_three_with_a_and_b;
  function chainThree(a: String | Undefined, b: Null) as chain_three_with_a_and_null;
  function chainThree(a: String | Undefined, b: Number | Undefined, c: bool) as chain_three_with_a_and_b_and_c;
  function chainThree(a: String | Undefined, b: Null, c: bool) as chain_three_with_a_and_null_and_c;
  function chainUnion() as chain_union;
  function chainUnion(a: String) as chain_union_with_str;
  function chainUnion(a: Array<String>) as chain_union_with_slice;
  function chainUnion(a: String | Undefined, b: f64) as chain_union_with_str_and_b;
  function chainUnion(a: Array<String>, b: f64) as chain_union_with_slice_and_b;
  function chainAlias() as chain_alias;
  function chainAlias(a: Source) as chain_alias_with_a;
  function chainAlias(a: Source | Undefined, b: f64) as chain_alias_with_a_and_b;
  function modeArg(m: Mode): Mode | Null as mode_arg;
  function modeArg(m: Null): Mode | Null as mode_arg_with_null;
  function modeBoth(): Mode | Null | Undefined as mode_both;
  function modeBoth(m: Mode): Mode | Null | Undefined as mode_both_with_m;
  function modeBoth(m: Null): Mode | Null | Undefined as mode_both_with_null;
  function modeOptional() as mode_optional;
  function modeOptional(m: Mode) as mode_optional_with_m;
  function modeOptional(m: Null) as mode_optional_with_null;
  function emptiesOnly(): Null | Undefined as empties_only;
  function emptiesOnly(x: Null): Null | Undefined as empties_only_with_null;
  function generic<T>(x: T | Null | Undefined): T | Null | Undefined;
  function generic<T>(x: Null): T | Null | Undefined as generic_with_null;
  function genericBoth<T>(): T | Null | Undefined as generic_both;
  function genericBoth<T>(x: T | Null | Undefined): T | Null | Undefined as generic_both_with_x;
  function genericBoth<T>(x: Null): T | Null | Undefined as generic_both_with_null;
  function inner(xs: Promise<String | Null>, ys: Array<Number | Undefined>);
  function innerBoth(xs: Promise<String | Null | Undefined>) as inner_both;
  function callback(cb: (String | Null) => void);
  function record(r: Record<String | Null>): Record<Number | Undefined>;
  function holder(h: Holder<String | Null>): Holder<Number | Undefined>;
  function fetchNull(): Promise<Registry | Null> as fetch_null;
  function fetchOptional(): Promise<Number | Undefined> as fetch_optional;
  function fetchBoth(): Promise<String | Null | Undefined> as fetch_both;
  function fetchGeneric<T>(): Promise<T | Null | Undefined> as fetch_generic;
  function numbers(xs: Array<Number>): Array<Number> | Null;
  function numbers(xs: Null): Array<Number> | Null as numbers_with_null;
  function numbersBoth(): Array<Number> | Null | Undefined as numbers_both;
  function numbersBoth(xs: Array<Number>): Array<Number> | Null | Undefined as numbers_both_with_xs;
  function numbersBoth(xs: Null): Array<Number> | Null | Undefined as numbers_both_with_null;
  function numbersOptional() as numbers_optional;
  function numbersOptional(xs: Array<Number>) as numbers_optional_with_xs;
  function numbersOptional(xs: Null) as numbers_optional_with_null;
  function bytes(xs: Uint8Array);
  function bytes(xs: Uint8Array) as bytes_with_uint8_array;
  function bytes(xs: Null) as bytes_with_null;
  function bytesBoth() as bytes_both;
  function bytesBoth(xs: Uint8Array) as bytes_both_with_slice;
  function bytesBoth(xs: Uint8Array) as bytes_both_with_uint8_array;
  function bytesBoth(xs: Null) as bytes_both_with_null;
  function jsdoc(x: String);
  function jsdoc(x: Null) as jsdoc_with_null;
  function send(attachment: Attachment);
  function upload(upload: Upload);
  function cover(cover: Cover);
}
