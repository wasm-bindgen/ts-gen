ir 1;

module "generic-mono" {
  class Holder<T> {
    new(value: T | Null | Undefined): Holder throws;
    get(): T | Null | Undefined;
    set(value: T | Null | Undefined);
  }

  class Store<T> {
    load(): Promise<T | Null | Undefined>;
    loadHolder(): Promise<Holder<T | Null | Undefined>> as load_holder;
    find(key: String): T | Null | Undefined;
  }

  shape class EvaluationDetails<T> {
    new {}: EvaluationDetails;
    get flagKey: String as flag_key;
    set flagKey(value: String) as set_flag_key;
    get value: T | Null | Undefined;
    set value(value: T | Null | Undefined) as set_value;
    get variant?: String | Undefined;
    set variant(value: String) as set_variant;
  }

  shape class Pair<A, B> {
    new {}: Pair;
    get first: A | Null | Undefined;
    set first(value: A | Null | Undefined) as set_first;
    get second: B | Null | Undefined;
    set second(value: B | Null | Undefined) as set_second;
  }

  shape class TypedArrayOptions {
    new {};
    get value: ArrayBufferView;
    set value(value: ArrayBufferView) as set_value;
    get extra?: ArrayBufferView | Undefined;
    set extra(value: ArrayBufferView) as set_extra;
  }

  class Flags {
    getStringValue(default_value: String): Promise<String> as get_string_value;
    getStringDetails(default_value: String): Promise<EvaluationDetails<String>> as get_string_details;
    getBooleanDetails(default_value: bool): Promise<EvaluationDetails<Boolean>> as get_boolean_details;
    getNumberDetails(default_value: f64): Promise<EvaluationDetails<Number>> as get_number_details;
    getNullableString(default_value: String): Promise<String | Undefined> as get_nullable_string;
    getStringPair(default_value: String): Promise<Pair<String, String>> as get_string_pair;
    getStringArray(): Promise<Array<String>> as get_string_array;
    getStringMap(): Promise<Map<String, String>> as get_string_map;
    getStringTuple(): Promise<[String, String]> as get_string_tuple;
    getStringCallback(): Promise<(String) => String> as get_string_callback;
    compareStrings(left: String, right: String): bool as compare_strings;
  }

  function identity<T>(value: T | Null | Undefined): T | Null | Undefined;

  /// ## Errors
  ///
  /// * `TypeError`
  function parseString(value: String): String raises TypeError as parse_string;
  function roundtripBoolean(value: bool): bool as roundtrip_boolean;
  function roundtripNumber(value: f64): f64 as roundtrip_number;
}
