ir 1;

static class N {
  static g(x: String);
  static g(x: f64) as g_with_f64;
}

class Twin {
  sz(x: String): String;
  sz(x: f64): f64 as sz_with_f64;
  gen<T>(x: T | Null | Undefined): T | Null | Undefined;
  gen(x: f64, y: f64): f64 as gen_with_f64_and_y;
  /// Reads text.
  read(x: String): String;
  /// Reads a byte.
  ///
  /// ## Errors
  ///
  /// * `RangeError` — When out of range.
  read(x: f64): f64 raises RangeError as read_with_f64;
  static of(x: String): Twin;
  static of(x: f64): f64 as of_with_f64;
}

function parse(input: String): Object;
function parse(input: ArrayBuffer): Object as parse_with_array_buffer;
function parse(input: String, reviver: () => Any | Null | Undefined): Object as parse_with_reviver;
function f(x: String);
function f(x: f64) as f_with_f64;
function sz(x: String): String;
function sz(x: f64): f64 as sz_with_f64;
function gen<T>(x: T | Null | Undefined): T | Null | Undefined;
function gen(x: f64, y: f64): f64 as gen_with_f64_and_y;

/// Reads text.
function read(x: String): String;

/// Reads a byte.
///
/// ## Errors
///
/// * `RangeError` — When out of range.
function read(x: f64): f64 raises RangeError as read_with_f64;
