ir 1;

static class N {
  static g(x: String) throws;
  static g(x: f64) throws as g_with_f64;
}

class Twin {
  sz(x: String): String throws;
  sz(x: f64): f64 throws as sz_with_f64;
  gen<T>(x: T | Null | Undefined): T | Null | Undefined throws;
  gen(x: f64, y: f64): f64 throws as gen_with_f64_and_y;
  /// Reads text.
  read(x: String): String throws;
  /// Reads a byte.
  ///
  /// ## Errors
  ///
  /// * `RangeError` — When out of range.
  read(x: f64): f64 throws RangeError as read_with_f64;
  static of(x: String): Twin throws;
  static of(x: f64): f64 throws as of_with_f64;
}

function parse(input: String): Object throws;
function parse(input: ArrayBuffer): Object throws as parse_with_array_buffer;
function parse(input: String, reviver: () => Any | Null | Undefined): Object throws as parse_with_reviver;
function f(x: String) throws;
function f(x: f64) throws as f_with_f64;
function sz(x: String): String throws;
function sz(x: f64): f64 throws as sz_with_f64;
function gen<T>(x: T | Null | Undefined): T | Null | Undefined throws;
function gen(x: f64, y: f64): f64 throws as gen_with_f64_and_y;

/// Reads text.
function read(x: String): String throws;

/// Reads a byte.
///
/// ## Errors
///
/// * `RangeError` — When out of range.
function read(x: f64): f64 throws RangeError as read_with_f64;
