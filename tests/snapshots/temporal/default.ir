  /// * `RangeError` — if a string does not parse, a field is out of range, the result does not exist under `overflow: 'reject'`, or the result is out of range
  /// * `TypeError` — if an object is missing the fields it needs
  subtract(duration: Temporal.DurationLike): Temporal.PlainDate raises RangeError | TypeError;
  /// ## Errors
  ///
  /// * `RangeError` — if a string does not parse, a field is out of range, the result does not exist under `overflow: 'reject'`, or the result is out of range
  /// * `TypeError` — if an object is missing the fields it needs
  subtract(duration: Temporal.DurationLike, options: Temporal.OverflowOptions): Temporal.PlainDate raises RangeError | TypeError as subtract_with_options;
