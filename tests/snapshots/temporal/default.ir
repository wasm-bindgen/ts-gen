  toLocaleString(locales: Array<String>): String raises RangeError | TypeError as to_locale_string_with_slice;
  /// ## Errors
  ///
  /// * `RangeError` — if the locale is invalid, or the calendar differs from the formatter's
  /// * `TypeError` — if the options conflict
  toLocaleString(locales: String | Undefined, options: Intl.DateTimeFormatOptions): String raises RangeError | TypeError as to_locale_string_with_str_and_options;
  /// ## Errors
  ///
  /// * `RangeError` — if the locale is invalid, or the calendar differs from the formatter's
  /// * `TypeError` — if the options conflict
  toLocaleString(locales: Array<String>, options: Intl.DateTimeFormatOptions): String raises RangeError | TypeError as to_locale_string_with_slice_and_options;
  toJSON(): String as to_json;
  valueOf() throws as value_of;
}

