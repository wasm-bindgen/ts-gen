  /// * `TypeError` — if an object is missing the fields it needs
  static compare(one: Temporal.PlainDateLike, two: Temporal.PlainDateLike): f64 raises RangeError | TypeError;
  get calendarId: String as calendar_id;
  get era: String | Undefined;
  get eraYear: Number | Undefined as era_year;
  get year: f64;
  get month: f64;
  get monthCode: String as month_code;
  get day: f64;
  get dayOfWeek: f64 as day_of_week;
  get dayOfYear: f64 as day_of_year;
  get weekOfYear: Number | Undefined as week_of_year;
  get yearOfWeek: Number | Undefined as year_of_week;
  get daysInWeek: f64 as days_in_week;
  get daysInMonth: f64 as days_in_month;
  get daysInYear: f64 as days_in_year;
  get monthsInYear: f64 as months_in_year;
  get inLeapYear: bool as in_leap_year;
  toPlainYearMonth(): Temporal.PlainYearMonth as to_plain_year_month;
  toPlainMonthDay(): Temporal.PlainMonthDay as to_plain_month_day;
  /// ## Errors
  ///
  /// * `RangeError` — if a string does not parse, a field is out of range, the result does not exist under `overflow: 'reject'`, or the result is out of range
  /// * `TypeError` — if an object is missing the fields it needs
  add(duration: Temporal.DurationLike): Temporal.PlainDate raises RangeError | TypeError;
  /// ## Errors
  ///
  /// * `RangeError` — if a string does not parse, a field is out of range, the result does not exist under `overflow: 'reject'`, or the result is out of range
  /// * `TypeError` — if an object is missing the fields it needs
