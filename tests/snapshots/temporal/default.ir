  toZonedDateTime(item: Temporal.PlainDateToZonedDateTimeOptions): Temporal.ZonedDateTime raises RangeError | TypeError as to_zoned_date_time_with_item;
  toString(): String as to_string;
  toString(options: Temporal.PlainDateToStringOptions): String as to_string_with_options;
  /// ## Errors
  ///
  /// * `RangeError` — if the locale is invalid, or the calendar differs from the formatter's
  /// * `TypeError` — if the options conflict
  toLocaleString(): String raises RangeError | TypeError as to_locale_string;
  /// ## Errors
