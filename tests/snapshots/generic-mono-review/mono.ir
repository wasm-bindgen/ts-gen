ir 1;

module "generic-mono-review" {
  class S {
    get x: f64;
  }

  class S2 {
    get x: f64;
  }

  class Holder<T> {
    new(value: T | Null | Undefined): Holder throws;
    get(): T | Null | Undefined throws;
  }
}

kind LiteralUnionReturnKind {
  A = "a";
  B = "b";
}

module "generic-mono-review" {
  function byAlias(id: String): String throws as by_alias;
  function asyncByAlias(id: String): Promise<String> throws as async_by_alias;
  function withS(s: S, s2: S2, name: String) throws as with_s;
  function takesHolder(h: Holder<String>, g: Holder<String>) throws as takes_holder;
  function holderOfId(): Holder<String> throws as holder_of_id;
  function literalHolder(): Holder<String> throws as literal_holder;
  function literalUnion(): LiteralUnionReturnKind throws as literal_union;
  function shadowsAlias<Id>(h: Holder<Id | Null | Undefined>): Holder<Id | Null | Undefined> throws as shadows_alias;
}
