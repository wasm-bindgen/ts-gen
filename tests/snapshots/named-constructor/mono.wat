  ;; x === undefined
  (import "./bindings.wasm" "JsValue.is_undefined" (func $JsValue.is_undefined (param $x externref) (result i32)))

  ;; Number
  ;; Number(x)
  (import "./bindings.wasm" "Number.value" (func $Number.value (param $x externref) (result f64)))

  ;; Codec
  ;; constructor(name: string)
  (import "./bindings.wasm" "Codec.new" (func $Codec.new (param $name externref) (result externref)))
  ;; static version: number
  (import "./bindings.wasm" "Codec.version" (func $Codec.version (result f64)))
  ;; isCodec(value: unknown): boolean
  (import "./bindings.wasm" "Codec.is_codec" (func $Codec.is_codec (param $value externref) (result i32)))
  ;; name: string
  (import "./bindings.wasm" "Codec.name" (func $Codec.name (param $this externref) (result externref)))
  ;; encode(input: string): Uint8Array
  (import "./bindings.wasm" "Codec.encode" (func $Codec.encode (param $this externref) (param $input externref) (result externref)))

  ;; Registry
  ;; constructor()
  (import "./bindings.wasm" "Registry.new" (func $Registry.new (result externref)))
  ;; lookup(name: string): Codec | undefined
  (import "./bindings.wasm" "Registry.lookup" (func $Registry.lookup (param $this externref) (param $name externref) (result externref)))

  ;; Factory
  ;; {} as Factory
  (import "./bindings.wasm" "Factory.new" (func $Factory.new (result externref)))
  ;; label: string
  (import "./bindings.wasm" "Factory.label" (func $Factory.label (param $this externref) (result externref)))
  ;; set label(value: string)
  (import "./bindings.wasm" "Factory.set_label" (func $Factory.set_label (param $this externref) (param $value externref)))

  ;; Widget
  ;; {} as Widget
  (import "./bindings.wasm" "Widget.new" (func $Widget.new (result externref)))
  ;; id: number
  (import "./bindings.wasm" "Widget.id" (func $Widget.id (param $this externref) (result f64)))
  ;; set id(value: number)
  (import "./bindings.wasm" "Widget.set_id" (func $Widget.set_id (param $this externref) (param $value f64)))

  ;; `undefined`, for passing where TS says `T | undefined`.
  (import "./builtins.js" "undefined" (global $undefined externref))

  ;; JSPI: suspends on a Promise and returns its value. Importing this
  ;; selects JSPI mode in `embed`, which wraps the handlers with promising.
  (import "./builtins.js" "await" (func $await (param externref) (result externref)))
)
