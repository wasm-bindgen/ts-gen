;; Generated by ts-gen. Import template for the Wasm ABI.
;;
;; Scalars: number -> f64, boolean -> i32, bigint -> i64.
;; All other values (strings, objects, null/undefined) are externref,
;; as JS produced them. Per position, embed also accepts anyref, and
;; (ref extern) / (ref any) where the TS type never admits null.
;;
;; Import names: Type.member with _with_x suffixes for overloads.
;; Dictionary constructors: Type.new creates {} (empty object).
;; Variables: declare var x -> x getter reading it from its scope.
;;
;; Declarations from `declare module "spec"` are imported from "spec".
;;
;; Unused imports need not be deleted; embed prunes to what you use.
(module

  ;; JsValue
  ;; x === undefined
  (import "./bindings.wasm" "JsValue.is_undefined" (func $JsValue.is_undefined (param $x externref) (result i32)))

  ;; Number
  ;; Number(x)
  (import "./bindings.wasm" "Number.value" (func $Number.value (param $x externref) (result f64)))

  ;; emit(name: Events.Name, options: Events.Opts): Events.Label
  (import "namespace-type-aliases" "emit" (func $namespace-type-aliases:emit (param $name externref) (param $options externref) (result externref)))
  ;; onEvent(listener: Events.Listener<string>): void
  (import "namespace-type-aliases" "onEvent" (func $namespace-type-aliases:onEvent (param $listener externref)))

  ;; Events.Options
  ;; {} as Events.Options
  (import "./bindings.wasm" "Events.Options.new" (func $Events.Options.new (result externref)))
  ;; name: Name
  (import "./bindings.wasm" "Events.Options.name" (func $Events.Options.name (param $this externref) (result externref)))
  ;; set name(value: Name)
  (import "./bindings.wasm" "Events.Options.set_name" (func $Events.Options.set_name (param $this externref) (param $value externref)))

  ;; Events
  ;; listen(name: Name, options: Opts): Label
  (import "./bindings.wasm" "Events.listen" (func $Events.listen (param $name externref) (param $options externref) (result externref)))
  ;; pair(p: Pair<string, number>): Result<number>
  (import "./bindings.wasm" "Events.pair" (func $Events.pair (param $p externref) (result externref)))

  ;; Events.Inner
  ;; find(id: Id): Options
  (import "./bindings.wasm" "Events.Inner.find" (func $Events.Inner.find (param $id externref) (result externref)))

  ;; `undefined`, for passing where TS says `T | undefined`.
  (import "./builtins.js" "undefined" (global $undefined externref))

  ;; JSPI: suspends on a Promise and returns its value. Importing this
  ;; selects JSPI mode in `embed`, which wraps the handlers with promising.
  (import "./builtins.js" "await" (func $await (param externref) (result externref)))
)
