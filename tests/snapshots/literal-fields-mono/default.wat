  ;; x === undefined
  (import "./bindings.wasm" "JsValue.is_undefined" (func $JsValue.is_undefined (param $x externref) (result i32)))

  ;; Number
  ;; Number(x)
  (import "./bindings.wasm" "Number.value" (func $Number.value (param $x externref) (result f64)))

  ;; Level
  ;; {} as Level
  (import "./bindings.wasm" "Level.new" (func $Level.new (result externref)))
  ;; level: 0 | 1 | 2
  (import "./bindings.wasm" "Level.level" (func $Level.level (param $this externref) (result externref)))
  ;; set level(value: 0)
  (import "./bindings.wasm" "Level.set_level" (func $Level.set_level (param $this externref) (param $value f64)))
  ;; name: string
  (import "./bindings.wasm" "Level.name" (func $Level.name (param $this externref) (result externref)))
  ;; set name(value: string)
  (import "./bindings.wasm" "Level.set_name" (func $Level.set_name (param $this externref) (param $value externref)))

  ;; Revoked
  ;; {} as Revoked
  (import "./bindings.wasm" "Revoked.new" (func $Revoked.new (result externref)))
  ;; revoked: "0" | "1"
  (import "./bindings.wasm" "Revoked.revoked" (func $Revoked.revoked (param $this externref) (result externref)))
  ;; set revoked(value: "0")
  (import "./bindings.wasm" "Revoked.set_revoked" (func $Revoked.set_revoked (param $this externref) (param $value externref)))
  ;; status: KeepAlive
  (import "./bindings.wasm" "Revoked.status" (func $Revoked.status (param $this externref) (result externref)))
  ;; set status(value: KeepAlive)
  (import "./bindings.wasm" "Revoked.set_status" (func $Revoked.set_status (param $this externref) (param $value externref)))

  ;; `undefined`, for passing where TS says `T | undefined`.
  (import "./builtins.js" "undefined" (global $undefined externref))

  ;; JSPI: suspends on a Promise and returns its value. Importing this
  ;; selects JSPI mode in `embed`, which wraps the handlers with promising.
  (import "./builtins.js" "await" (func $await (param externref) (result externref)))
)
