;; Generated by ts-gen. Import template for the Wasm ABI.
;;
;; Scalars: number -> f64, boolean -> i32, bigint -> i64.
;; All other values (strings, objects, null/undefined) are externref,
;; as JS produced them. A position whose TS type never admits null
;; may be taken as (ref extern).
;;
;; Import names: Type.member with _with_x suffixes for overloads.
;; Dictionary constructors: Type.new creates {} (empty object).
;; Variables: declare var x -> x getter reading it from its scope.
;;
;; Import only what you use; unused entries need not be deleted.
(module

  ;; JsValue
  ;; x === undefined
  (import "./bindings.wasm" "JsValue.is_undefined" (func $JsValue.is_undefined (param $x externref) (result i32)))

  ;; Number
  ;; Number(x)
  (import "./bindings.wasm" "Number.value" (func $Number.value (param $x externref) (result f64)))

  ;; Holder
  ;; constructor()
  (import "./bindings.wasm" "Holder.new" (func $Holder.new (result externref)))
  ;; constructor(initial: Value)
  (import "./bindings.wasm" "Holder.new_with_initial" (func $Holder.new_with_initial (param $initial externref) (result externref)))
  ;; value?: Value
  (import "./bindings.wasm" "Holder.value" (func $Holder.value (param $this externref) (result externref)))
  ;; reset(): Holder<Value>
  (import "./bindings.wasm" "Holder.reset" (func $Holder.reset (param $this externref) (result externref)))

  ;; Pair
  ;; constructor(first: A, second: B)
  (import "./bindings.wasm" "Pair.new" (func $Pair.new (param $first externref) (param $second externref) (result externref)))
  ;; swap(pair: Pair<A, B>): Pair<B, A>
  (import "./bindings.wasm" "Pair.swap" (func $Pair.swap (param $pair externref) (result externref)))
  ;; first: A
  (import "./bindings.wasm" "Pair.first" (func $Pair.first (param $this externref) (result externref)))
  ;; second: B
  (import "./bindings.wasm" "Pair.second" (func $Pair.second (param $this externref) (result externref)))

  ;; Slot
  ;; constructor(value: T)
  (import "./bindings.wasm" "Slot.new" (func $Slot.new (param $value externref) (result externref)))
  ;; value: T
  (import "./bindings.wasm" "Slot.value" (func $Slot.value (param $this externref) (result externref)))
  ;; set value(value: T)
  (import "./bindings.wasm" "Slot.set_value" (func $Slot.set_value (param $this externref) (param $value externref)))

  ;; `undefined`, for passing where TS says `T | undefined`.
  (import "./builtins.js" "undefined" (global $undefined externref))

  ;; JSPI: suspends on a Promise and returns its value. A module that
  ;; imports this has its provided functions wrapped with promising.
  (import "./builtins.js" "await" (func $await (param externref) (result externref)))
)
