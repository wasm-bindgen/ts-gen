ir 1;

module "enum-positions" {
  static class Codes {}

  class Holder<T> {
    new(value: T | Null | Undefined): Holder throws;
    get(): T | Null | Undefined;
    set(value: T | Null | Undefined);
  }

  shape class Details<T> {
    new {}: Details;
    get value: T | Null | Undefined;
    set value(value: T | Null | Undefined) as set_value;
    get fallback?: T | Null | Undefined;
    set fallback(value: T | Null | Undefined) as set_fallback;
  }

  class Probe {
    get level: Level;
    set level(value: Level) as set_level;
    region(r: Codes.Region);
    regionOf(): Codes.Region as region_of;
    alias(m: Mode);
    levels(ls: Array<Level>): Array<Level>;
    modes(ms: Array<Mode>): Array<Mode>;
    modeArray(ms: Array<Mode>): Array<Mode> as mode_array;
    rest(...ms: Array<Mode>);
    onMode(cb: (Mode) => Level) as on_mode;
    nextMode(): Promise<Mode> as next_mode;
    maybeMode(): Promise<Mode | Null> as maybe_mode;
    modeMap(): Map<String, Mode> as mode_map;
    modeRecord(): Record<Mode> as mode_record;
    pair(): [Mode, Level];
    modeOrNumber(): ModeOrNumberReturnKind as mode_or_number;
    modeOrString(): ModeOrStringReturnKind as mode_or_string;
    modeOrRegion(): ModeOrRegionReturnKind as mode_or_region;
    levelOrString(): LevelOrStringReturnKind as level_or_string;
    holder(h: Holder<Mode>): Holder<Level>;
    details(d: Details<Mode>): Details<Level>;
    maybeHolder(): Holder<Mode | Null> as maybe_holder;
    nextLevel(): Promise<Level | Undefined> as next_level;
    nextDetails(): Promise<Details<Mode>> as next_details;
    modeOrNumberArg(x: Mode): ModeOrNumberReturnKind as mode_or_number_arg;
    modeOrNumberArg(x: f64): ModeOrNumberReturnKind as mode_or_number_arg_with_f64;
    modeOrNumberOrString(x: Mode) as mode_or_number_or_string;
    modeOrNumberOrString(x: f64) as mode_or_number_or_string_with_f64;
    modeOrNumberOrString(x: String) as mode_or_number_or_string_with_str;
  }

  kind Mode {
    Fast = "fast";
    Slow = "slow";
  }

  kind Level {
    Low = 1;
    High = 2;
  }

  kind Codes.Region {
    Eu = "eu";
    Us = "us";
  }
}

kind ModeOrNumberReturnKind {
  Mode = "enum-positions".Mode;
  F64 = Number;
}

kind ModeOrStringReturnKind {
  Mode = "enum-positions".Mode;
  String = String;
}

kind ModeOrRegionReturnKind {
  Mode = "enum-positions".Mode;
  Region = "enum-positions".Codes.Region;
}

kind LevelOrStringReturnKind {
  Level = "enum-positions".Level;
  String = String;
}
