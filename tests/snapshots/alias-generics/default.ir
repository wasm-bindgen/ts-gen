ir 1;

shape class Request<Meta> {
  new {}: Request;
  get meta: Meta | Null | Undefined;
}

class Client {
  send(input: Request<Request>);
  send(input: String) as send_with_str;
  sendDefault(input: Request<Any | Null | Undefined>) as send_default;
  sendDefault(input: String) as send_default_with_str;
  pairs(): Promise<[Number, String]>;
  same(): Promise<[Number, Number]>;
  boxed(items: Array<String>);
}

module "shapes" {
  shape class _Shape {
    new {};
    get sides: f64;
  }
  alias Shape = _Shape;
  alias Polygon = _Shape;
}

module "hidden" {
  shape class Hidden {
    new {};
    get h: f64;
  }
}

module "uses" {
  function tag(t: [String, "shapes"._Shape]);
  function triple(t: [Number, String, "hidden".Hidden]);
  function either(e: Any);
}
