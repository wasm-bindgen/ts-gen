  (import "./bindings.wasm" "Client.send" (func $Client.send (param $this externref) (param $input externref)))
  ;; sendDefault(input: Info): void
  (import "./bindings.wasm" "Client.send_default" (func $Client.send_default (param $this externref) (param $input externref)))
  ;; pairs(): Promise<Pair<number>>
  (import "./bindings.wasm" "Client.pairs" (func $Client.pairs (param $this externref) (result externref)))
  ;; same(): Promise<Same<number>>
  (import "./bindings.wasm" "Client.same" (func $Client.same (param $this externref) (result externref)))
  ;; boxed(items: Boxed<string>): void
  (import "./bindings.wasm" "Client.boxed" (func $Client.boxed (param $this externref) (param $items externref)))

  ;; _Shape
  ;; {} as _Shape
  (import "./bindings.wasm" "_Shape.new" (func $_Shape.new (result externref)))
  ;; sides: number
  (import "./bindings.wasm" "_Shape.sides" (func $_Shape.sides (param $this externref) (result f64)))

  ;; Hidden
  ;; {} as Hidden
  (import "./bindings.wasm" "Hidden.new" (func $Hidden.new (result externref)))
