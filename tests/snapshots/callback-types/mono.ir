ir 1;

class Timer {
  setTimeout(callback: (Array<Any | Null | Undefined>) => void): f64 throws as set_timeout;
  setTimeout(callback: (Array<Any | Null | Undefined>) => void, ms_delay: f64): f64 throws as set_timeout_with_ms_delay;
  onTick(callback: (f64, String) => bool) throws as on_tick;
  onAny(callback: (Any | Null | Undefined) => Any | Null | Undefined) throws as on_any;
  onRest(callback: (String, Array<Number>) => void) throws as on_rest;
}
