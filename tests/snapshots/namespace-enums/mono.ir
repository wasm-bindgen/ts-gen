ir 1;

static class Timing {}

module "namespace-enums" {
  kind DurationUnit {
    Second = "second";
    Minute = "minute";
  }

  kind TimingDurationUnit {
    Day = "day";
    Week = "week";
  }

  kind Precision {
    Low = 1;
    High = 2;
  }
}

