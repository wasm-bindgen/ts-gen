/// This is the event type for `fetch` events dispatched on the ServiceWorkerGlobalScope.
///
/// [MDN Reference](https://developer.mozilla.org/docs/Web/API/FetchEvent)
class FetchEvent extends ExtendableEvent {
  /// The **`request`** read-only property of the the event handler.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/FetchEvent/request)
  get request: Request;
  /// The **`respondWith()`** method of allows you to provide a promise for a Response yourself.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/FetchEvent/respondWith)
  respondWith(promise: Response) as respond_with;
  /// The **`respondWith()`** method of allows you to provide a promise for a Response yourself.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/FetchEvent/respondWith)
  respondWith(promise: Promise<Response>) as respond_with_and_promise;
  passThroughOnException() as pass_through_on_exception;
}

/// The **`Headers`** interface of the Fetch API allows you to perform various actions on HTTP request and response headers.
///
/// [MDN Reference](https://developer.mozilla.org/docs/Web/API/Headers)
class Headers {
  new() throws;
  new(init: Headers) throws as new_with_headers;
  new(init: Any | Null | Undefined) throws as new_with_iterable;
  new(init: Record<String>) throws as new_with_record;
  /// The **`get()`** method of the Headers interface returns a byte string of all the values of a header within a `Headers` object with a given name.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/Headers/get)
  get(name: String): String | Null;
  getAll(name: String): Array<String> as get_all;
  /// The **`getSetCookie()`** method of the Headers interface returns an array containing the values of all Set-Cookie headers associated with a response.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/Headers/getSetCookie)
  getSetCookie(): Array<String> as get_set_cookie;
  /// The **`has()`** method of the Headers interface returns a boolean stating whether a `Headers` object contains a certain header.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/Headers/has)
  has(name: String): bool;
  /// The **`set()`** method of the Headers interface sets a new value for an existing header inside a `Headers` object, or adds the header if it does not already exist.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/Headers/set)
  set(name: String, value: String);
  /// The **`append()`** method of the Headers interface appends a new value onto an existing header inside a `Headers` object, or adds the header if it does not already exist.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/Headers/append)
  append(name: String, value: String);
  /// The **`delete()`** method of the Headers interface deletes a header from the current `Headers` object.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/Headers/delete)
  delete(name: String);
  forEach(callback: (String, String, Headers) => void) as for_each;
  forEach<This>(callback: (String, String, Headers) => void, this_arg: This | Null | Undefined) as for_each_with_this_arg;
  entries(): Iterator<[String, String]>;
  keys(): Iterator<String>;
  values(): Iterator<String>;
}

class Body {
  get body: ReadableStream | Null;
  get bodyUsed: bool as body_used;
  arrayBuffer(): Promise<ArrayBuffer> as array_buffer;
  bytes(): Promise<Uint8Array>;
  text(): Promise<String>;
  json<T>(): Promise<T | Null | Undefined>;
  formData(): Promise<FormData> as form_data;
  blob(): Promise<Blob>;
}

/// The **`Response`** interface of the Fetch API represents the response to a request.
///
/// [MDN Reference](https://developer.mozilla.org/docs/Web/API/Response)
class Response extends Body {
  new() throws;
  new(body: ReadableStream<Uint8Array>) throws as new_with_readable_stream;
  new(body: String) throws as new_with_str;
  new(body: ArrayBuffer) throws as new_with_array_buffer;
  new(body: ArrayBufferView) throws as new_with_typed_array;
  new(body: Blob) throws as new_with_blob;
  new(body: URLSearchParams) throws as new_with_url_search_params;
  new(body: FormData) throws as new_with_form_data;
  new(body: Any | Null | Undefined) throws as new_with_iterable;
  new(body: Null) throws as new_with_null;
  new(body: ReadableStream<Uint8Array> | Undefined, init: ResponseInit) throws as new_with_readable_stream_and_init;
  new(body: String, init: ResponseInit) throws as new_with_str_and_init;
  new(body: ArrayBuffer, init: ResponseInit) throws as new_with_array_buffer_and_init;
  new(body: ArrayBufferView, init: ResponseInit) throws as new_with_typed_array_and_init;
  new(body: Blob, init: ResponseInit) throws as new_with_blob_and_init;
  new(body: URLSearchParams, init: ResponseInit) throws as new_with_url_search_params_and_init;
  new(body: FormData, init: ResponseInit) throws as new_with_form_data_and_init;
  new(body: Any | Null | Undefined, init: ResponseInit) throws as new_with_iterable_and_init;
  new(body: Null, init: ResponseInit) throws as new_with_null_and_init;
  static error(): Response;
  static redirect(url: String): Response;
  static redirect(url: String, status: f64): Response as redirect_with_status;
  static json(any: Any | Null | Undefined): Response;
  static json(any: Any | Null | Undefined, maybe_init: ResponseInit): Response as json_with_response_init;
  static json(any: Any | Null | Undefined, maybe_init: Response): Response as json_with_response;
  /// The **`clone()`** method of the Response interface creates a clone of a response object, identical in every way, but stored in a different variable.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/Response/clone)
  clone(): Response;
  /// The **`status`** read-only property of the Response interface contains the HTTP status codes of the response.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/Response/status)
  get status: f64;
  set status(value: f64) as set_status;
  /// The **`statusText`** read-only property of the Response interface contains the status message corresponding to the HTTP status code in Response.status.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/Response/statusText)
  get statusText: String as status_text;
  set statusText(value: String) as set_status_text;
  /// The **`headers`** read-only property of the with the response.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/Response/headers)
  get headers: Headers;
  set headers(value: Headers) as set_headers;
  /// The **`ok`** read-only property of the Response interface contains a Boolean stating whether the response was successful (status in the range 200-299) or not.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/Response/ok)
  get ok: bool;
  set ok(value: bool) as set_ok;
  /// The **`redirected`** read-only property of the Response interface indicates whether or not the response is the result of a request you made which was redirected.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/Response/redirected)
  get redirected: bool;
  set redirected(value: bool) as set_redirected;
  /// The **`url`** read-only property of the Response interface contains the URL of the response.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/Response/url)
  get url: String;
  set url(value: String) as set_url;
  get webSocket: WebSocket | Null as web_socket;
  set webSocket(value: WebSocket) as set_web_socket;
  set webSocket(value: Null) as set_web_socket_with_null;
  get cf: Any | Null | Undefined;
  set cf(value: Any | Null | Undefined) as set_cf;
  /// The **`type`** read-only property of the Response interface contains the type of the response.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/Response/type)
  get type: TypeKind as type_;
  set type(value: TypeKind) as set_type;
}

shape class ResponseInit {
  new {};
  get status?: Number | Undefined;
  set status(value: f64) as set_status;
  get statusText?: String | Undefined as status_text;
  set statusText(value: String) as set_status_text;
  get headers?: HeadersKind | Undefined;
  set headers(value: Headers) as set_headers;
  set headers(value: Any | Null | Undefined) as set_headers_with_iterable;
  set headers(value: Record<String>) as set_headers_with_record;
  get cf?: Any | Null | Undefined;
  set cf(value: Any | Null | Undefined) as set_cf;
  get webSocket?: WebSocket | Null | Undefined as web_socket;
  set webSocket(value: WebSocket) as set_web_socket;
  set webSocket(value: Null) as set_web_socket_with_null;
  get encodeBody?: EncodeBodyKind | Undefined as encode_body;
  set encodeBody(value: EncodeBodyKind) as set_encode_body;
}

/// The **`Request`** interface of the Fetch API represents a resource request.
///
/// [MDN Reference](https://developer.mozilla.org/docs/Web/API/Request)
class Request<CfHostMetadata, Cf> extends Body {
  new(input: Request<Any, Any>): Request throws;
  new(input: String): Request throws as new_with_str;
  new(input: URL): Request throws as new_with_url;
  new(input: Request<Any, Any>, init: RequestInit<Cf | Null | Undefined>): Request throws as new_with_init;
  new(input: String, init: RequestInit<Cf | Null | Undefined>): Request throws as new_with_str_and_init;
  new(input: URL, init: RequestInit<Cf | Null | Undefined>): Request throws as new_with_url_and_init;
  /// The **`clone()`** method of the Request interface creates a copy of the current `Request` object.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/Request/clone)
  clone(): Request<CfHostMetadata | Null | Undefined, Cf | Null | Undefined>;
  /// The **`method`** read-only property of the `POST`, etc.) A String indicating the method of the request.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/Request/method)
  get method: String;
  set method(value: String) as set_method;
  /// The **`url`** read-only property of the Request interface contains the URL of the request.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/Request/url)
  get url: String;
  set url(value: String) as set_url;
  /// The **`headers`** read-only property of the with the request.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/Request/headers)
  get headers: Headers;
  set headers(value: Headers) as set_headers;
  /// The **`redirect`** read-only property of the Request interface contains the mode for how redirects are handled.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/Request/redirect)
  get redirect: String;
  set redirect(value: String) as set_redirect;
  get fetcher: Fetcher | Null;
  set fetcher(value: Fetcher) as set_fetcher;
  set fetcher(value: Null) as set_fetcher_with_null;
  /// The read-only **`signal`** property of the Request interface returns the AbortSignal associated with the request.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/Request/signal)
  get signal: AbortSignal;
  set signal(value: AbortSignal) as set_signal;
  get cf?: Cf | Null | Undefined;
  set cf(value: Cf | Null | Undefined) as set_cf;
  /// The **`integrity`** read-only property of the Request interface contains the subresource integrity value of the request.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/Request/integrity)
  get integrity: String;
  set integrity(value: String) as set_integrity;
  /// The **`keepalive`** read-only property of the Request interface contains the request's `keepalive` setting (`true` or `false`), which indicates whether the browser will keep the associated request alive if the page that initiated it is unloaded before the request is complete.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/Request/keepalive)
  get keepalive: bool;
  set keepalive(value: bool) as set_keepalive;
  /// The **`cache`** read-only property of the Request interface contains the cache mode of the request.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/Request/cache)
  get cache?: CacheKind | Undefined;
  set cache(value: CacheKind) as set_cache;
}

shape class RequestInit<Cf> {
  new {}: RequestInit;
  get method?: String | Undefined;
  set method(value: String) as set_method;
  get headers?: HeadersKind | Undefined;
  set headers(value: Headers) as set_headers;
  set headers(value: Any | Null | Undefined) as set_headers_with_iterable;
  set headers(value: Record<String>) as set_headers_with_record;
  get body?: BodyKind | Null | Undefined;
  set body(value: ReadableStream<Uint8Array>) as set_body;
  set body(value: String) as set_body_with_str;
  set body(value: ArrayBuffer) as set_body_with_array_buffer;
  set body(value: ArrayBufferView) as set_body_with_typed_array;
  set body(value: Blob) as set_body_with_blob;
  set body(value: URLSearchParams) as set_body_with_url_search_params;
  set body(value: FormData) as set_body_with_form_data;
  set body(value: Any | Null | Undefined) as set_body_with_iterable;
  set body(value: Null) as set_body_with_null;
  get redirect?: String | Undefined;
  set redirect(value: String) as set_redirect;
  get fetcher?: Fetcher | Null | Undefined;
  set fetcher(value: Fetcher) as set_fetcher;
  set fetcher(value: Null) as set_fetcher_with_null;
  get cf?: Cf | Null | Undefined;
  set cf(value: Cf | Null | Undefined) as set_cf;
  get cache?: CacheKind | Undefined;
  set cache(value: CacheKind) as set_cache;
  get integrity?: String | Undefined;
  set integrity(value: String) as set_integrity;
  get signal?: AbortSignal | Null | Undefined;
  set signal(value: AbortSignal) as set_signal;
  set signal(value: Null) as set_signal_with_null;
  get encodeResponseBody?: EncodeBodyKind | Undefined as encode_response_body;
  set encodeResponseBody(value: EncodeBodyKind) as set_encode_response_body;
}

shape class Fetcher<T> {
  fetch(input: Request<Any | Null | Undefined, Any>): Promise<Response>;
  fetch(input: String): Promise<Response> as fetch_with_str;
  fetch(input: URL): Promise<Response> as fetch_with_url;
  fetch(input: Request<Any | Null | Undefined, Any>, init: RequestInit): Promise<Response> as fetch_with_init;
  fetch(input: String, init: RequestInit): Promise<Response> as fetch_with_str_and_init;
  fetch(input: URL, init: RequestInit): Promise<Response> as fetch_with_url_and_init;
  connect(address: SocketAddress): Socket;
  connect(address: String): Socket as connect_with_str;
  connect(address: SocketAddress, options: SocketOptions): Socket as connect_with_options;
  connect(address: String, options: SocketOptions): Socket as connect_with_str_and_options;
}

shape class KVNamespaceListKey<Metadata> {
