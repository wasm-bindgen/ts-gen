  static get OPEN: f64 as open;
  static get READY_STATE_CLOSING: f64 as ready_state_closing;
  static get CLOSING: f64 as closing;
  static get READY_STATE_CLOSED: f64 as ready_state_closed;
  static get CLOSED: f64 as closed;
  accept();
  accept(options: WebSocketAcceptOptions) as accept_with_options;
  /// The **`WebSocket.send()`** method enqueues the specified data to be transmitted to the server over the WebSocket connection, increasing the value of `bufferedAmount` by the number of bytes needed to contain the data.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/WebSocket/send)
  send(message: ArrayBuffer);
  /// The **`WebSocket.send()`** method enqueues the specified data to be transmitted to the server over the WebSocket connection, increasing the value of `bufferedAmount` by the number of bytes needed to contain the data.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/WebSocket/send)
  send(message: ArrayBufferView) as send_with_typed_array;
  /// The **`WebSocket.send()`** method enqueues the specified data to be transmitted to the server over the WebSocket connection, increasing the value of `bufferedAmount` by the number of bytes needed to contain the data.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/WebSocket/send)
  send(message: String) as send_with_str;
  /// The **`WebSocket.close()`** method closes the already `CLOSED`, this method does nothing.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/WebSocket/close)
  close();
  /// The **`WebSocket.close()`** method closes the already `CLOSED`, this method does nothing.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/WebSocket/close)
  close(code: f64) as close_with_code;
