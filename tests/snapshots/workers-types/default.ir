shape class HostedImagesBinding {
  /// Get detailed metadata for a hosted image
  ///
  /// * `imageId` - The ID of the image (UUID or custom ID)
  ///
  /// Returns: Image metadata, or null if not found
  details(image_id: String): Promise<ImageMetadata | Null>;
