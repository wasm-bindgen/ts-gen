shape class ImageTransformer {
  /// Apply transform next, returning a transform handle.
  /// You can then apply more transformations, draw, or retrieve the output.
  ///
  /// * `transform`
  transform(transform: ImageTransform): ImageTransformer;
  /// Draw an image on this transformer, returning a transform handle.
  /// You can then apply more transformations, draw, or retrieve the output.
  ///
  /// * `image` - The image (or transformer that will give the image) to draw
  /// * `options` - The options configuring how to draw the image
  draw(image: ReadableStream<Uint8Array>): ImageTransformer;
  /// Draw an image on this transformer, returning a transform handle.
  /// You can then apply more transformations, draw, or retrieve the output.
  ///
  /// * `image` - The image (or transformer that will give the image) to draw
  /// * `options` - The options configuring how to draw the image
  draw(image: ImageTransformer): ImageTransformer as draw_with_image_transformer;
  /// Draw an image on this transformer, returning a transform handle.
  /// You can then apply more transformations, draw, or retrieve the output.
  ///
  /// * `image` - The image (or transformer that will give the image) to draw
  /// * `options` - The options configuring how to draw the image
  draw(image: ReadableStream<Uint8Array>, options: ImageDrawOptions): ImageTransformer as draw_with_options;
  /// Draw an image on this transformer, returning a transform handle.
  /// You can then apply more transformations, draw, or retrieve the output.
  ///
  /// * `image` - The image (or transformer that will give the image) to draw
  /// * `options` - The options configuring how to draw the image
  draw(image: ImageTransformer, options: ImageDrawOptions): ImageTransformer as draw_with_image_transformer_and_options;
  /// Retrieve the image that results from applying the transforms to the
  /// provided input
  ///
  /// * `options` - Options that apply to the output e.g. output format
  output(options: ImageOutputOptions): Promise<ImageTransformationResult>;
}

shape class ImageTransformationOutputOptions {
