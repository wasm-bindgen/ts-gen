shape class InferenceUpstreamError extends Error {}

shape class AiInternalError extends Error {}

class Ai<AiModelList> {
  get aiGatewayLogId: String | Null as ai_gateway_log_id;
  set aiGatewayLogId(value: String) as set_ai_gateway_log_id;
  set aiGatewayLogId(value: Null) as set_ai_gateway_log_id_with_null;
  gateway(gateway_id: String): AiGateway;
  /// Access the AI Search API for managing AI-powered search instances.
  ///
  /// This is the new API that replaces AutoRAG with better namespace separation:
  /// - Account-level operations: `list()`, `create()`
  /// - Instance-level operations: `get(id).search()`, `get(id).chatCompletions()`, `get(id).delete()`
  ///
  /// ## Example
  ///
  /// ```js
  /// ```typescript
  /// // List all AI Search instances
  /// const instances = await env.AI.aiSearch.list();
  ///
  /// // Search an instance
  /// const results = await env.AI.aiSearch.get('my-search').search({
  ///   messages: [{ role: 'user', content: 'What is the policy?' }],
  ///   ai_search_options: {
  ///     retrieval: { max_num_results: 10 }
  ///   }
  /// });
  ///
  /// // Generate chat completions with AI Search context
  /// const response = await env.AI.aiSearch.get('my-search').chatCompletions({
  ///   messages: [{ role: 'user', content: 'What is the policy?' }],
  ///   model: '@cf/meta/llama-3.3-70b-instruct-fp8-fast'
  /// });
  /// ```
  /// ```
  aiSearch(): AiSearchAccountService as ai_search;
  /// @deprecated AutoRAG has been replaced by AI Search.
  /// Use `env.AI.aiSearch` instead for better API design and new features.
  ///
  /// Migration guide:
  /// - `env.AI.autorag().list()` â†’ `env.AI.aiSearch.list()`
  /// - `env.AI.autorag('id').search({ query: '...' })` â†’ `env.AI.aiSearch.get('id').search({ messages: [{ role: 'user', content: '...' }] })`
  /// - `env.AI.autorag('id').aiSearch(...)` â†’ `env.AI.aiSearch.get('id').chatCompletions(...)`
  ///
  /// Note: The old API continues to work for backwards compatibility, but new projects should use AI Search.
  ///
  /// @see AiSearchAccountService
  ///
  /// * `autoragId` - Optional instance ID (omit for account-level operations)
  autorag(autorag_id: String): AutoRAG;
  run<InputOptions>(model: String, inputs: InputOptions | Null | Undefined): Promise<Any>;
  run<InputOptions, Options>(model: String, inputs: InputOptions | Null | Undefined, options: Options | Null | Undefined): Promise<Any> as run_with_options;
  models(): Promise<Array<AiModelsSearchObject>>;
  models(params: AiModelsSearchParams): Promise<Array<AiModelsSearchObject>> as models_with_params;
  toMarkdown(): ToMarkdownService as to_markdown;
  toMarkdown(files: Array<MarkdownDocument>): Promise<Array<ConversionResponse>> as to_markdown_with_slice;
  toMarkdown(files: Array<MarkdownDocument>, options: ConversionRequestOptions): Promise<Array<ConversionResponse>> as to_markdown_with_slice_and_options;
  toMarkdown(files: MarkdownDocument): Promise<ConversionResponse> as to_markdown_with_markdown_document;
  toMarkdown(files: MarkdownDocument, options: ConversionRequestOptions): Promise<ConversionResponse> as to_markdown_with_markdown_document_and_options;
}

