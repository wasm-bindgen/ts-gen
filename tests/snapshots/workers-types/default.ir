  before(content: String, options: ContentOptions): Element as before_with_options;
  before(content: ReadableStream, options: ContentOptions): Element as before_with_readable_stream_and_options;
  before(content: Response, options: ContentOptions): Element as before_with_response_and_options;
  after(content: String): Element;
