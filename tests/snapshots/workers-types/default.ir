class D1Database {
  prepare(query: String): D1PreparedStatement;
  batch(statements: Array<D1PreparedStatement>): Promise<Array<D1Result<Any | Null | Undefined>>>;
  exec(query: String): Promise<D1ExecResult>;
  /// Creates a new D1 Session anchored at the given constraint or the bookmark.
  /// All queries executed using the created session will have sequential consistency,
  /// meaning that all writes done through the session will be visible in subsequent reads.
  ///
  /// * `constraintOrBookmark` - Either the session constraint or the explicit bookmark to anchor the created session.
  withSession(): D1DatabaseSession as with_session;
  /// Creates a new D1 Session anchored at the given constraint or the bookmark.
  /// All queries executed using the created session will have sequential consistency,
  /// meaning that all writes done through the session will be visible in subsequent reads.
  ///
  /// * `constraintOrBookmark` - Either the session constraint or the explicit bookmark to anchor the created session.
  withSession(constraint_or_bookmark: String): D1DatabaseSession as with_session_with_str;
  /// Creates a new D1 Session anchored at the given constraint or the bookmark.
  /// All queries executed using the created session will have sequential consistency,
  /// meaning that all writes done through the session will be visible in subsequent reads.
  ///
  /// * `constraintOrBookmark` - Either the session constraint or the explicit bookmark to anchor the created session.
  withSession(constraint_or_bookmark: D1SessionConstraint): D1DatabaseSession as with_session_with_d1_session_constraint;
  /// @deprecated dump() will be removed soon, only applies to deprecated alpha v1 databases.
  dump(): Promise<ArrayBuffer>;
}

