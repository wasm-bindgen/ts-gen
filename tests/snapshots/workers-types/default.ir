  /// * `options` - Configuration options to massage the returned data.
  ///
  /// Returns: A promise that resolves with matched and scored vectors.
  query(vector: Array<Number>, options: VectorizeQueryOptions): Promise<VectorizeMatches> as query_with_slice_and_options;
  /// Use the provided vector-id to perform a similarity search across the index.
  ///
  /// * `vectorId` - Id for a vector in the index against which the index should be queried.
  /// * `options` - Configuration options to massage the returned data.
  ///
  /// Returns: A promise that resolves with matched and scored vectors.
  queryById(vector_id: String): Promise<VectorizeMatches> as query_by_id;
