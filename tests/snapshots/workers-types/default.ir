/// The **`ServiceWorkerGlobalScope`** interface of the Service Worker API represents the global execution context of a service worker.
/// Available only in secure contexts.
///
/// [MDN Reference](https://developer.mozilla.org/docs/Web/API/ServiceWorkerGlobalScope)
shape class ServiceWorkerGlobalScope extends WorkerGlobalScope {
  get DOMException: Any as dom_exception;
  set DOMException(value: Any) as set_dom_exception;
  get WorkerGlobalScope: Any as worker_global_scope;
  set WorkerGlobalScope(value: Any) as set_worker_global_scope;
  btoa(data: String): String;
  atob(data: String): String;
  setTimeout(callback: (Array<Any | Null | Undefined>) => void): f64 as set_timeout;
  setTimeout(callback: (Array<Any | Null | Undefined>) => void, ms_delay: f64): f64 as set_timeout_with_ms_delay;
  setTimeout(callback: (Any | Null | Undefined) => void, ...args: Array<Any | Null | Undefined>): f64 as set_timeout_with_function_and_args;
  setTimeout(callback: (Any | Null | Undefined) => void, ms_delay: f64, ...args: Array<Any | Null | Undefined>): f64 as set_timeout_with_function_and_ms_delay_and_args;
  clearTimeout(timeout_id: f64) as clear_timeout;
  clearTimeout(timeout_id: Null) as clear_timeout_with_null;
  setInterval(callback: (Array<Any | Null | Undefined>) => void): f64 as set_interval;
  setInterval(callback: (Array<Any | Null | Undefined>) => void, ms_delay: f64): f64 as set_interval_with_ms_delay;
  setInterval(callback: (Any | Null | Undefined) => void, ...args: Array<Any | Null | Undefined>): f64 as set_interval_with_function_and_args;
  setInterval(callback: (Any | Null | Undefined) => void, ms_delay: f64, ...args: Array<Any | Null | Undefined>): f64 as set_interval_with_function_and_ms_delay_and_args;
  clearInterval(timeout_id: f64) as clear_interval;
  clearInterval(timeout_id: Null) as clear_interval_with_null;
  queueMicrotask(task: () => Any | Null | Undefined) as queue_microtask;
  structuredClone<T>(value: T | Null | Undefined): T | Null | Undefined as structured_clone;
  structuredClone<T>(value: T | Null | Undefined, options: StructuredSerializeOptions): T | Null | Undefined as structured_clone_with_options;
  reportError(error: Any | Null | Undefined) as report_error;
  fetch(input: Request<Any | Null | Undefined, Any>): Promise<Response>;
  fetch(input: String): Promise<Response> as fetch_with_str;
  fetch(input: URL): Promise<Response> as fetch_with_url;
  fetch(input: Request<Any | Null | Undefined, Any>, init: RequestInit<RequestInitCfProperties>): Promise<Response> as fetch_with_init;
  fetch(input: String, init: RequestInit<RequestInitCfProperties>): Promise<Response> as fetch_with_str_and_init;
  fetch(input: URL, init: RequestInit<RequestInitCfProperties>): Promise<Response> as fetch_with_url_and_init;
  get self: ServiceWorkerGlobalScope as self_;
  set self(value: ServiceWorkerGlobalScope) as set_self;
  get crypto: Crypto;
  set crypto(value: Crypto) as set_crypto;
  get caches: CacheStorage;
  set caches(value: CacheStorage) as set_caches;
  get scheduler: Scheduler;
  set scheduler(value: Scheduler) as set_scheduler;
  get performance: Performance;
  set performance(value: Performance) as set_performance;
  get Cloudflare: Cloudflare as cloudflare;
  set Cloudflare(value: Cloudflare) as set_cloudflare;
  get origin: String;
  get Event: Any as event;
  set Event(value: Any) as set_event;
  get ExtendableEvent: Any as extendable_event;
  set ExtendableEvent(value: Any) as set_extendable_event;
  get CustomEvent: Any as custom_event;
  set CustomEvent(value: Any) as set_custom_event;
  get PromiseRejectionEvent: Any as promise_rejection_event;
  set PromiseRejectionEvent(value: Any) as set_promise_rejection_event;
  get FetchEvent: Any as fetch_event;
  set FetchEvent(value: Any) as set_fetch_event;
  get TailEvent: Any as tail_event;
  set TailEvent(value: Any) as set_tail_event;
  get TraceEvent: Any as trace_event;
  set TraceEvent(value: Any) as set_trace_event;
  get ScheduledEvent: Any as scheduled_event;
  set ScheduledEvent(value: Any) as set_scheduled_event;
  get MessageEvent: Any as message_event;
