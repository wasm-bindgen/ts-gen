  query(vector: Array<Number>): Promise<VectorizeMatches> as query_with_slice;
  /// Use the provided vector to perform a similarity search across the index.
  ///
  /// * `vector` - Input vector that will be used to drive the similarity search.
  /// * `options` - Configuration options to massage the returned data.
  ///
