/// [MDN Reference](https://developer.mozilla.org/docs/Web/API/FormData)
class FormData {
  new() throws;
  /// The **`append()`** method of the FormData interface appends a new value onto an existing key inside a `FormData` object, or adds the key if it does not already exist.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/FormData/append)
  append(name: String, value: String);
  /// The **`append()`** method of the FormData interface appends a new value onto an existing key inside a `FormData` object, or adds the key if it does not already exist.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/FormData/append)
  append(name: String, value: Blob) as append_with_blob;
  /// The **`append()`** method of the FormData interface appends a new value onto an existing key inside a `FormData` object, or adds the key if it does not already exist.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/FormData/append)
  append(name: String, value: Blob, filename: String) as append_with_blob_and_filename;
  /// The **`delete()`** method of the FormData interface deletes a key and its value(s) from a `FormData` object.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/FormData/delete)
  delete(name: String);
  /// The **`get()`** method of the FormData interface returns the first value associated with a given key from within a `FormData` object.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/FormData/get)
  get(name: String): Any | Null;
  /// The **`getAll()`** method of the FormData interface returns all the values associated with a given key from within a `FormData` object.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/FormData/getAll)
  getAll(name: String): Array<Any> as get_all;
  /// The **`has()`** method of the FormData interface returns whether a `FormData` object contains a certain key.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/FormData/has)
  has(name: String): bool;
  /// The **`set()`** method of the FormData interface sets a new value for an existing key inside a `FormData` object, or adds the key/value if it does not already exist.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/FormData/set)
  set(name: String, value: String);
  /// The **`set()`** method of the FormData interface sets a new value for an existing key inside a `FormData` object, or adds the key/value if it does not already exist.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/FormData/set)
  set(name: String, value: Blob) as set_with_blob;
  /// The **`set()`** method of the FormData interface sets a new value for an existing key inside a `FormData` object, or adds the key/value if it does not already exist.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/FormData/set)
  set(name: String, value: Blob, filename: String) as set_with_blob_and_filename;
  entries(): Iterator<[String, Any]>;
  keys(): Iterator<String>;
  values(): Iterator<Any>;
  forEach(callback: (Any, String, FormData) => void) as for_each;
  forEach<This>(callback: (Any, String, FormData) => void, this_arg: This | Null | Undefined) as for_each_with_this_arg;
}

shape class ContentOptions {
  new {};
  get html?: Boolean | Undefined;
  set html(value: bool) as set_html;
}

class HTMLRewriter {
  new() throws;
  on(selector: String, handlers: HTMLRewriterElementContentHandlers): HTMLRewriter;
  onDocument(handlers: HTMLRewriterDocumentContentHandlers): HTMLRewriter as on_document;
  transform(response: Response): Response;
}

shape class HTMLRewriterElementContentHandlers {
  element(element: Element): Promise<Undefined> | Undefined;
  comments(comment: Comment): Promise<Undefined> | Undefined;
  text(element: Text): Promise<Undefined> | Undefined;
}

shape class HTMLRewriterDocumentContentHandlers {
  doctype(doctype: Doctype): Promise<Undefined> | Undefined;
  comments(comment: Comment): Promise<Undefined> | Undefined;
  text(text: Text): Promise<Undefined> | Undefined;
  end(end: DocumentEnd): Promise<Undefined> | Undefined;
}

shape class Doctype {
  new {};
