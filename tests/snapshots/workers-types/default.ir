  get CloseEvent: Any as close_event;
  set CloseEvent(value: Any) as set_close_event;
  get ReadableStreamDefaultReader: Any as readable_stream_default_reader;
  set ReadableStreamDefaultReader(value: Any) as set_readable_stream_default_reader;
  get ReadableStreamBYOBReader: Any as readable_stream_byob_reader;
