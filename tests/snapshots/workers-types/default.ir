shape class StreamWatermark {
  new {};
  /// The unique identifier for a watermark profile.
  get id: String;
  set id(value: String) as set_id;
  /// The size of the image in bytes.
  get size: f64;
  set size(value: f64) as set_size;
  /// The height of the image in pixels.
  get height: f64;
  set height(value: f64) as set_height;
  /// The width of the image in pixels.
  get width: f64;
  set width(value: f64) as set_width;
  /// The date and a time a watermark profile was created.
  get created: String;
  set created(value: String) as set_created;
  /// The source URL for a downloaded image. If the watermark profile was created via
  /// direct upload, this field is null.
  get downloadedFrom: String | Null as downloaded_from;
  set downloadedFrom(value: String) as set_downloaded_from;
  set downloadedFrom(value: Null) as set_downloaded_from_with_null;
  /// A short description of the watermark profile.
  get name: String;
  set name(value: String) as set_name;
  /// The translucency of the image. A value of `0.0` makes the image completely
  /// transparent, and `1.0` makes the image completely opaque. Note that if the image
  /// is already semi-transparent, setting this to `1.0` will not make the image
  /// completely opaque.
  get opacity: f64;
  set opacity(value: f64) as set_opacity;
  /// The whitespace between the adjacent edges (determined by position) of the video
  /// and the image. `0.0` indicates no padding, and `1.0` indicates a fully padded
  /// video width or length, as determined by the algorithm.
  get padding: f64;
  set padding(value: f64) as set_padding;
  /// The size of the image relative to the overall size of the video. This parameter
  /// will adapt to horizontal and vertical videos automatically. `0.0` indicates no
  /// scaling (use the size of the image as-is), and `1.0 `fills the entire video.
  get scale: f64;
  set scale(value: f64) as set_scale;
  /// The location of the image. Valid positions are: `upperRight`, `upperLeft`,
  /// `lowerLeft`, `lowerRight`, and `center`. Note that `center` ignores the
  /// `padding` parameter.
  get position: StreamWatermarkPosition;
  set position(value: StreamWatermarkPosition) as set_position;
}

shape class StreamWatermarkCreateParams {
  new {};
  /// A short description of the watermark profile.
  get name?: String | Undefined;
  set name(value: String) as set_name;
  /// The translucency of the image. A value of `0.0` makes the image completely
  /// transparent, and `1.0` makes the image completely opaque. Note that if the
  /// image is already semi-transparent, setting this to `1.0` will not make the
  /// image completely opaque.
  get opacity?: Number | Undefined;
  set opacity(value: f64) as set_opacity;
  /// The whitespace between the adjacent edges (determined by position) of the
  /// video and the image. `0.0` indicates no padding, and `1.0` indicates a fully
  /// padded video width or length, as determined by the algorithm.
  get padding?: Number | Undefined;
  set padding(value: f64) as set_padding;
  /// The size of the image relative to the overall size of the video. This
  /// parameter will adapt to horizontal and vertical videos automatically. `0.0`
  /// indicates no scaling (use the size of the image as-is), and `1.0 `fills the
  /// entire video.
  get scale?: Number | Undefined;
  set scale(value: f64) as set_scale;
  /// The location of the image.
  get position?: StreamWatermarkPosition | Undefined;
  set position(value: StreamWatermarkPosition) as set_position;
}

shape class StreamVideosListParams {
