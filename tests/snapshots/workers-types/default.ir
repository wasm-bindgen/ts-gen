shape class AiOptions {
  new {};
  /// Send requests as an asynchronous batch job, only works for supported models
  /// https://developers.cloudflare.com/workers-ai/features/batch-api
  get queueRequest?: Boolean | Undefined as queue_request;
  set queueRequest(value: bool) as set_queue_request;
  /// Establish websocket connections, only works for supported models
  get websocket?: Boolean | Undefined;
  set websocket(value: bool) as set_websocket;
  /// Tag your requests to group and view them in Cloudflare dashboard.
  ///
  /// Rules:
  /// Tags must only contain letters, numbers, and the symbols: : - . / @
  /// Each tag can have maximum 50 characters.
  /// Maximum 5 tags are allowed each request.
  /// Duplicate tags will removed.
  get tags?: Array<String> | Undefined;
  set tags(value: Array<String>) as set_tags;
  get gateway?: GatewayOptions | Undefined;
  set gateway(value: GatewayOptions) as set_gateway;
  get returnRawResponse?: Boolean | Undefined as return_raw_response;
  set returnRawResponse(value: bool) as set_return_raw_response;
  get prefix?: String | Undefined;
  set prefix(value: String) as set_prefix;
  get extraHeaders?: Object | Undefined as extra_headers;
  set extraHeaders(value: Object) as set_extra_headers;
}

