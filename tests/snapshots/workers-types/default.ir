    get ctx: DurableObjectState<Props | Null | Undefined>;
    set ctx(value: DurableObjectState<Props | Null | Undefined>) as set_ctx;
    get env: Env | Null | Undefined;
    set env(value: Env | Null | Undefined) as set_env;
    alarm(): Promise<Undefined> | Undefined;
    alarm(alarm_info: AlarmInvocationInfo): Promise<Undefined> | Undefined as alarm_with_alarm_info;
    fetch(request: Request): FetchReturnKind;
    webSocketMessage(ws: WebSocket, message: String): Promise<Undefined> | Undefined as web_socket_message;
    webSocketMessage(ws: WebSocket, message: ArrayBuffer): Promise<Undefined> | Undefined as web_socket_message_with_array_buffer;
    webSocketClose(ws: WebSocket, code: f64, reason: String, was_clean: bool): Promise<Undefined> | Undefined as web_socket_close;
    webSocketError(ws: WebSocket, error: Any | Null | Undefined): Promise<Undefined> | Undefined as web_socket_error;
  }

  shape class WorkflowStepConfig {
    new {};
    get retries?: Object | Undefined;
    set retries(value: Object) as set_retries;
    get timeout?: TimeoutKind | Undefined;
    set timeout(value: WorkflowTimeoutDuration) as set_timeout;
    set timeout(value: f64) as set_timeout_with_f64;
  }

  shape class WorkflowEvent<T> {
    new {}: WorkflowEvent;
    get payload: T | Null | Undefined;
    set payload(value: T | Null | Undefined) as set_payload;
    get timestamp: Date;
    set timestamp(value: Date) as set_timestamp;
    get instanceId: String as instance_id;
    set instanceId(value: String) as set_instance_id;
  }

  shape class WorkflowStepEvent<T> {
    new {}: WorkflowStepEvent;
    get payload: T | Null | Undefined;
    set payload(value: T | Null | Undefined) as set_payload;
    get timestamp: Date;
    set timestamp(value: Date) as set_timestamp;
    get type: String as type_;
    set type(value: String) as set_type;
  }

  shape class WorkflowStepContext {
    new {};
    get attempt: f64;
    set attempt(value: f64) as set_attempt;
  }

  class WorkflowStep {
    do<T>(name: String, callback: (WorkflowStepContext) => Promise<T | Null | Undefined>): Promise<T | Null | Undefined> as do_;
    do<T>(name: String, config: WorkflowStepConfig, callback: (WorkflowStepContext) => Promise<T | Null | Undefined>): Promise<T | Null | Undefined> as do_with_config;
    get sleep: (String, Any) => Promise<Undefined>;
    set sleep(value: (String, Any) => Promise<Undefined>) as set_sleep;
    get sleepUntil: (String, Any) => Promise<Undefined> as sleep_until;
    set sleepUntil(value: (String, Any) => Promise<Undefined>) as set_sleep_until;
    waitForEvent(name: String, options: WorkflowStepOptions): Promise<WorkflowStepEvent<Any | Null | Undefined>> as wait_for_event;
  }

  shape class WorkflowStepOptions {
    new {};
    get type: String as type_;
    set type(value: String) as set_type;
    get timeout?: TimeoutKind | Undefined;
    set timeout(value: WorkflowTimeoutDuration) as set_timeout;
    set timeout(value: f64) as set_timeout_with_f64;
  }

  class WorkflowEntrypoint<Env, T> {
    get ctx: ExecutionContext;
    set ctx(value: ExecutionContext) as set_ctx;
    get env: Env | Null | Undefined;
    set env(value: Env | Null | Undefined) as set_env;
    run(event: WorkflowEvent<T | Null | Undefined>, step: WorkflowStep): Promise<Any | Null | Undefined>;
  }
}

shape class SecretsStoreSecret {
  /// Get a secret from the Secrets Store, returning a string of the secret value
  /// if it exists, or throws an error if it does not exist
  get(): Promise<String>;
}

/// Binding entrypoint for Cloudflare Stream.
///
/// Usage:
/// - Binding-level operations:
///   `await env.STREAM.videos.upload`
///   `await env.STREAM.videos.createDirectUpload`
///   `await env.STREAM.videos.*`
///   `await env.STREAM.watermarks.*`
/// - Per-video operations:
///   `await env.STREAM.video(id).downloads.*`
///   `await env.STREAM.video(id).captions.*`
///
/// Example usage:
/// ```ts
/// await env.STREAM.video(id).downloads.generate();
///
/// const video = env.STREAM.video(id)
/// const captions = video.captions.list();
/// const videoDetails = video.details()
/// ```
shape class StreamBinding {
  /// Returns a handle scoped to a single video for per-video operations.
  ///
  /// * `id` - The unique identifier for the video.
  ///
  /// Returns: A handle for per-video operations.
  video(id: String): StreamVideoHandle;
  /// Uploads a new video from a File.
  ///
  /// * `file` - The video file to upload.
  ///
  /// Returns: The uploaded video details.
  ///
  /// ## Errors
  ///
  /// * `BadRequestError` — if the upload parameter is invalid
  /// * `QuotaReachedError` — if the account storage capacity is exceeded
  /// * `MaxFileSizeError` — if the file size is too large
  /// * `RateLimitedError` — if the server received too many requests
  /// * `InternalError` — if an unexpected error occurs
  upload(file: File): Promise<StreamVideo> raises BadRequestError | QuotaReachedError | MaxFileSizeError | RateLimitedError | InternalError;
  /// Uploads a new video from a provided URL.
  ///
  /// * `url` - The URL to upload from.
  /// * `params` - Optional upload parameters.
  ///
  /// Returns: The uploaded video details.
  ///
  /// ## Errors
  ///
  /// * `BadRequestError` — if the upload parameter is invalid or the URL is invalid
  /// * `QuotaReachedError` — if the account storage capacity is exceeded
  /// * `MaxFileSizeError` — if the file size is too large
  /// * `RateLimitedError` — if the server received too many requests
  /// * `AlreadyUploadedError` — if a video was already uploaded to this URL
  /// * `InternalError` — if an unexpected error occurs
  upload(url: String): Promise<StreamVideo> raises BadRequestError | QuotaReachedError | MaxFileSizeError | RateLimitedError | AlreadyUploadedError | InternalError as upload_with_url;
  /// Uploads a new video from a provided URL.
  ///
  /// * `url` - The URL to upload from.
  /// * `params` - Optional upload parameters.
  ///
  /// Returns: The uploaded video details.
  ///
  /// ## Errors
  ///
  /// * `BadRequestError` — if the upload parameter is invalid or the URL is invalid
  /// * `QuotaReachedError` — if the account storage capacity is exceeded
  /// * `MaxFileSizeError` — if the file size is too large
  /// * `RateLimitedError` — if the server received too many requests
  /// * `AlreadyUploadedError` — if a video was already uploaded to this URL
  /// * `InternalError` — if an unexpected error occurs
  upload(url: String, params: StreamUrlUploadParams): Promise<StreamVideo> raises BadRequestError | QuotaReachedError | MaxFileSizeError | RateLimitedError | AlreadyUploadedError | InternalError as upload_with_url_and_params;
  /// Creates a direct upload that allows video uploads without an API key.
  ///
  /// * `params` - Parameters for the direct upload
  ///
  /// Returns: The direct upload details.
  ///
  /// ## Errors
  ///
  /// * `BadRequestError` — if the parameters are invalid
  /// * `RateLimitedError` — if the server received too many requests
  /// * `InternalError` — if an unexpected error occurs
  createDirectUpload(params: StreamDirectUploadCreateParams): Promise<StreamDirectUpload> raises BadRequestError | RateLimitedError | InternalError as create_direct_upload;
  get videos: StreamVideos;
  set videos(value: StreamVideos) as set_videos;
  get watermarks: StreamWatermarks;
  set watermarks(value: StreamWatermarks) as set_watermarks;
}

/// Handle for operations scoped to a single Stream video.
shape class StreamVideoHandle {
  /// The unique identifier for the video.
  get id: String;
  set id(value: String) as set_id;
  /// Get a full videos details
  ///
  /// Returns: The full video details.
  ///
  /// ## Errors
  ///
  /// * `NotFoundError` — if the video is not found
  /// * `InternalError` — if an unexpected error occurs
  details(): Promise<StreamVideo> raises NotFoundError | InternalError;
  /// Update details for a single video.
  ///
  /// * `params` - The fields to update for the video.
  ///
  /// Returns: The updated video details.
  ///
  /// ## Errors
  ///
  /// * `NotFoundError` — if the video is not found
  /// * `BadRequestError` — if the parameters are invalid
  /// * `InternalError` — if an unexpected error occurs
  update(params: StreamUpdateVideoParams): Promise<StreamVideo> raises NotFoundError | BadRequestError | InternalError;
  /// Deletes a video and its copies from Cloudflare Stream.
  ///
  /// Returns: A promise that resolves when deletion completes.
  ///
  /// ## Errors
  ///
  /// * `NotFoundError` — if the video is not found
  /// * `InternalError` — if an unexpected error occurs
  delete(): Promise<Undefined> raises NotFoundError | InternalError;
  /// Creates a signed URL token for a video.
  ///
  /// Returns: The signed token that was created.
  ///
  /// ## Errors
  ///
  /// * `InternalError` — if the signing key cannot be retrieved or the token cannot be signed
  generateToken(): Promise<String> raises InternalError as generate_token;
  get downloads: StreamScopedDownloads;
  set downloads(value: StreamScopedDownloads) as set_downloads;
  get captions: StreamScopedCaptions;
  set captions(value: StreamScopedCaptions) as set_captions;
}

shape class StreamVideo {
  new {};
  /// The unique identifier for the video.
  get id: String;
  set id(value: String) as set_id;
  /// A user-defined identifier for the media creator.
  get creator: String | Null;
  set creator(value: String) as set_creator;
  set creator(value: Null) as set_creator_with_null;
  /// The thumbnail URL for the video.
  get thumbnail: String;
  set thumbnail(value: String) as set_thumbnail;
  /// The thumbnail timestamp percentage.
  get thumbnailTimestampPct: f64 as thumbnail_timestamp_pct;
  set thumbnailTimestampPct(value: f64) as set_thumbnail_timestamp_pct;
  /// Indicates whether the video is ready to stream.
  get readyToStream: bool as ready_to_stream;
  set readyToStream(value: bool) as set_ready_to_stream;
  /// The date and time the video became ready to stream.
  get readyToStreamAt: String | Null as ready_to_stream_at;
  set readyToStreamAt(value: String) as set_ready_to_stream_at;
  set readyToStreamAt(value: Null) as set_ready_to_stream_at_with_null;
  /// Processing status information.
  get status: StreamVideoStatus;
  set status(value: StreamVideoStatus) as set_status;
  /// A user modifiable key-value store.
  get meta: Record<String>;
  set meta(value: Record<String>) as set_meta;
  /// The date and time the video was created.
  get created: String;
  set created(value: String) as set_created;
  /// The date and time the video was last modified.
  get modified: String;
  set modified(value: String) as set_modified;
  /// The date and time at which the video will be deleted.
  get scheduledDeletion: String | Null as scheduled_deletion;
  set scheduledDeletion(value: String) as set_scheduled_deletion;
  set scheduledDeletion(value: Null) as set_scheduled_deletion_with_null;
  /// The size of the video in bytes.
  get size: f64;
  set size(value: f64) as set_size;
  /// The preview URL for the video.
  get preview?: String | Undefined;
  set preview(value: String) as set_preview;
  /// Origins allowed to display the video.
  get allowedOrigins: Array<String> as allowed_origins;
  set allowedOrigins(value: Array<String>) as set_allowed_origins;
  /// Indicates whether signed URLs are required.
  get requireSignedURLs: Boolean | Null as require_signed_ur_ls;
  set requireSignedURLs(value: bool) as set_require_signed_ur_ls;
  set requireSignedURLs(value: Null) as set_require_signed_ur_ls_with_null;
  /// The date and time the video was uploaded.
  get uploaded: String | Null;
  set uploaded(value: String) as set_uploaded;
  set uploaded(value: Null) as set_uploaded_with_null;
  /// The date and time when the upload URL expires.
  get uploadExpiry: String | Null as upload_expiry;
  set uploadExpiry(value: String) as set_upload_expiry;
  set uploadExpiry(value: Null) as set_upload_expiry_with_null;
  /// The maximum size in bytes for direct uploads.
  get maxSizeBytes: Number | Null as max_size_bytes;
  set maxSizeBytes(value: f64) as set_max_size_bytes;
  set maxSizeBytes(value: Null) as set_max_size_bytes_with_null;
  /// The maximum duration in seconds for direct uploads.
  get maxDurationSeconds: Number | Null as max_duration_seconds;
  set maxDurationSeconds(value: f64) as set_max_duration_seconds;
  set maxDurationSeconds(value: Null) as set_max_duration_seconds_with_null;
  /// The video duration in seconds. -1 indicates unknown.
  get duration: f64;
  set duration(value: f64) as set_duration;
  /// Input metadata for the original upload.
  get input: StreamVideoInput;
  set input(value: StreamVideoInput) as set_input;
  /// Playback URLs for the video.
  get hlsPlaybackUrl: String as hls_playback_url;
  set hlsPlaybackUrl(value: String) as set_hls_playback_url;
  get dashPlaybackUrl: String as dash_playback_url;
  set dashPlaybackUrl(value: String) as set_dash_playback_url;
  /// The watermark applied to the video, if any.
  get watermark: StreamWatermark | Null;
  set watermark(value: StreamWatermark) as set_watermark;
  set watermark(value: Null) as set_watermark_with_null;
  /// The live input id associated with the video, if any.
  get liveInputId?: String | Null | Undefined as live_input_id;
  set liveInputId(value: String) as set_live_input_id;
  set liveInputId(value: Null) as set_live_input_id_with_null;
  /// The source video id if this is a clip.
  get clippedFromId: String | Null as clipped_from_id;
  set clippedFromId(value: String) as set_clipped_from_id;
  set clippedFromId(value: Null) as set_clipped_from_id_with_null;
  /// Public details associated with the video.
  get publicDetails: StreamPublicDetails | Null as public_details;
  set publicDetails(value: StreamPublicDetails) as set_public_details;
  set publicDetails(value: Null) as set_public_details_with_null;
}

shape class StreamVideoStatus {
  new {};
  /// The current processing state.
  get state: String;
  set state(value: String) as set_state;
  /// The current processing step.
  get step?: String | Undefined;
  set step(value: String) as set_step;
  /// The percent complete as a string.
  get pctComplete?: String | Undefined as pct_complete;
  set pctComplete(value: String) as set_pct_complete;
  /// An error reason code, if applicable.
  get errorReasonCode: String as error_reason_code;
  set errorReasonCode(value: String) as set_error_reason_code;
  /// An error reason text, if applicable.
  get errorReasonText: String as error_reason_text;
  set errorReasonText(value: String) as set_error_reason_text;
}

