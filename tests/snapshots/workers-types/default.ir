shape class ExportedHandler<Env, QueueHandlerMessage, CfHostMetadata, Props> {
  new {}: ExportedHandler;
  get fetch?: ((Request<CfHostMetadata | Null | Undefined, IncomingRequestCfProperties<CfHostMetadata | Null | Undefined>>, Env | Null | Undefined, ExecutionContext<Props | Null | Undefined>) => Any) | Undefined;
  set fetch(value: (Request<CfHostMetadata | Null | Undefined, IncomingRequestCfProperties<CfHostMetadata | Null | Undefined>>, Env | Null | Undefined, ExecutionContext<Props | Null | Undefined>) => Any) as set_fetch;
  get tail?: ((Array<TraceItem>, Env | Null | Undefined, ExecutionContext<Props | Null | Undefined>) => Promise<Undefined> | Undefined) | Undefined;
  set tail(value: (Array<TraceItem>, Env | Null | Undefined, ExecutionContext<Props | Null | Undefined>) => Promise<Undefined> | Undefined) as set_tail;
  get trace?: ((Array<TraceItem>, Env | Null | Undefined, ExecutionContext<Props | Null | Undefined>) => Promise<Undefined> | Undefined) | Undefined;
  set trace(value: (Array<TraceItem>, Env | Null | Undefined, ExecutionContext<Props | Null | Undefined>) => Promise<Undefined> | Undefined) as set_trace;
  get tailStream?: ((TailStream.TailEvent<TailStream.Onset>, Env | Null | Undefined, ExecutionContext<Props | Null | Undefined>) => Any) | Undefined as tail_stream;
  set tailStream(value: (TailStream.TailEvent<TailStream.Onset>, Env | Null | Undefined, ExecutionContext<Props | Null | Undefined>) => Any) as set_tail_stream;
