ir 1;

/// The **`DOMException`** interface represents an abnormal event (called an **exception**) that occurs as a result of calling a method or accessing a property of a web API.
///
/// [MDN Reference](https://developer.mozilla.org/docs/Web/API/DOMException)
class DOMException extends Error {
  new() throws;
  new(message: String) throws as new_with_message;
  new(message: String | Undefined, name: String) throws as new_with_message_and_name;
  /// The **`message`** read-only property of the a message or description associated with the given error name.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/DOMException/message)
  get message: String;
  /// The **`name`** read-only property of the one of the strings associated with an error name.
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/DOMException/name)
  get name: String;
  /// The **`code`** read-only property of the DOMException interface returns one of the legacy error code constants, or `0` if none match.
  /// @deprecated
  ///
  /// [MDN Reference](https://developer.mozilla.org/docs/Web/API/DOMException/code)
  get code: f64;
  static get INDEX_SIZE_ERR: f64 as index_size_err;
  static get DOMSTRING_SIZE_ERR: f64 as domstring_size_err;
  static get HIERARCHY_REQUEST_ERR: f64 as hierarchy_request_err;
  static get WRONG_DOCUMENT_ERR: f64 as wrong_document_err;
  static get INVALID_CHARACTER_ERR: f64 as invalid_character_err;
  static get NO_DATA_ALLOWED_ERR: f64 as no_data_allowed_err;
  static get NO_MODIFICATION_ALLOWED_ERR: f64 as no_modification_allowed_err;
  static get NOT_FOUND_ERR: f64 as not_found_err;
  static get NOT_SUPPORTED_ERR: f64 as not_supported_err;
  static get INUSE_ATTRIBUTE_ERR: f64 as inuse_attribute_err;
  static get INVALID_STATE_ERR: f64 as invalid_state_err;
  static get SYNTAX_ERR: f64 as syntax_err;
  static get INVALID_MODIFICATION_ERR: f64 as invalid_modification_err;
  static get NAMESPACE_ERR: f64 as namespace_err;
  static get INVALID_ACCESS_ERR: f64 as invalid_access_err;
  static get VALIDATION_ERR: f64 as validation_err;
  static get TYPE_MISMATCH_ERR: f64 as type_mismatch_err;
  static get SECURITY_ERR: f64 as security_err;
  static get NETWORK_ERR: f64 as network_err;
  static get ABORT_ERR: f64 as abort_err;
  static get URL_MISMATCH_ERR: f64 as url_mismatch_err;
  static get QUOTA_EXCEEDED_ERR: f64 as quota_exceeded_err;
  static get TIMEOUT_ERR: f64 as timeout_err;
  static get INVALID_NODE_TYPE_ERR: f64 as invalid_node_type_err;
  static get DATA_CLONE_ERR: f64 as data_clone_err;
  get stack: Any | Null | Undefined;
  set stack(value: Any | Null | Undefined) as set_stack;
}

