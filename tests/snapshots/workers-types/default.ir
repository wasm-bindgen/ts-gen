  upload(image: ReadableStream<Uint8Array>): Promise<ImageMetadata> raises ImagesError;
  /// Upload a new hosted image
  ///
  /// * `image` - The image file to upload
  /// * `options` - Upload configuration
  ///
  /// Returns: Metadata for the uploaded image
  ///
  /// ## Errors
  ///
  /// * `ImagesError` — if upload fails
  upload(image: ArrayBuffer): Promise<ImageMetadata> raises ImagesError as upload_with_array_buffer;
  /// Upload a new hosted image
  ///
  /// * `image` - The image file to upload
  /// * `options` - Upload configuration
  ///
  /// Returns: Metadata for the uploaded image
  ///
  /// ## Errors
  ///
  /// * `ImagesError` — if upload fails
