  get certSubjectDN: String as cert_subject_dn;
  set certSubjectDN(value: String) as set_cert_subject_dn;
  /// The certificate issuer's [distinguished name](https://knowledge.digicert.com/generalinformation/INFO1745.html) ([RFC 2253](https://www.rfc-editor.org/rfc/rfc2253.html) formatted)
  ///
  /// @example "CN=cloudflareaccess.com, C=US, ST=Texas, L=Austin, O=Cloudflare"
  get certIssuerDNRFC2253: String as cert_issuer_dnrfc2253;
  set certIssuerDNRFC2253(value: String) as set_cert_issuer_dnrfc2253;
  /// The certificate subject's [distinguished name](https://knowledge.digicert.com/generalinformation/INFO1745.html) ([RFC 2253](https://www.rfc-editor.org/rfc/rfc2253.html) formatted)
  ///
  /// @example "CN=*.cloudflareaccess.com, C=US, ST=Texas, L=Austin, O=Cloudflare"
