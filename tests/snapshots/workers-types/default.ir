  set certSerial(value: String) as set_cert_serial;
  /// The certificate issuer's serial number
  ///
  /// @example "2489002934BDFEA34"
  get certIssuerSerial: String as cert_issuer_serial;
  set certIssuerSerial(value: String) as set_cert_issuer_serial;
  /// The certificate's Subject Key Identifier
  ///
  /// @example "BB:AF:7E:02:3D:FA:A6:F1:3C:84:8E:AD:EE:38:98:EC:D9:32:32:D4"
  get certSKI: String as cert_ski;
  set certSKI(value: String) as set_cert_ski;
  /// The certificate issuer's Subject Key Identifier
  ///
  /// @example "BB:AF:7E:02:3D:FA:A6:F1:3C:84:8E:AD:EE:38:98:EC:D9:32:32:D4"
  get certIssuerSKI: String as cert_issuer_ski;
  set certIssuerSKI(value: String) as set_cert_issuer_ski;
  /// The certificate's SHA-1 fingerprint
  ///
  /// @example "6b9109f323999e52259cda7373ff0b4d26bd232e"
