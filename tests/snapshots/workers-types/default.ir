  /// Upload a new hosted image
  ///
  /// * `image` - The image file to upload
  /// * `options` - Upload configuration
  ///
  /// Returns: Metadata for the uploaded image
  ///
  /// ## Errors
  ///
  /// * `ImagesError` — if upload fails
  upload(image: ArrayBuffer, options: ImageUploadOptions): Promise<ImageMetadata> raises ImagesError as upload_with_array_buffer_and_options;
  /// Update hosted image metadata
  ///
  /// * `imageId` - The ID of the image
  /// * `options` - Properties to update
  ///
  /// Returns: Updated image metadata
  ///
  /// ## Errors
  ///
  /// * `ImagesError` — if update fails
  update(image_id: String, options: ImageUpdateOptions): Promise<ImageMetadata> raises ImagesError;
  /// Delete a hosted image
  ///
