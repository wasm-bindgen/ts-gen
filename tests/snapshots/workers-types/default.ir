}

/// An email message that is sent to a consumer Worker and can be rejected/forwarded.
shape class ForwardableEmailMessage extends "cloudflare:email".EmailMessage {
  /// Stream of the email message content.
  get raw: ReadableStream<Uint8Array>;
  /// An [Headers object](https://developer.mozilla.org/en-US/docs/Web/API/Headers).
  get headers: Headers;
  /// Size of the email message content.
  get rawSize: f64 as raw_size;
  /// Reject this email message by returning a permanent SMTP error back to the connecting client including the given reason.
  ///
  /// * `reason` - The reject reason.
  ///
  /// Returns: void
  setReject(reason: String) as set_reject;
  /// Forward this email message to a verified destination address of the account.
  ///
  /// * `rcptTo` - Verified destination address.
  /// * `headers` - A [Headers object](https://developer.mozilla.org/en-US/docs/Web/API/Headers).
  ///
  /// Returns: A promise that resolves when the email message is forwarded.
  forward(rcpt_to: String): Promise<EmailSendResult>;
  /// Forward this email message to a verified destination address of the account.
  ///
  /// * `rcptTo` - Verified destination address.
  /// * `headers` - A [Headers object](https://developer.mozilla.org/en-US/docs/Web/API/Headers).
  ///
  /// Returns: A promise that resolves when the email message is forwarded.
  forward(rcpt_to: String, headers: Headers): Promise<EmailSendResult> as forward_with_headers;
  /// Reply to the sender of this email message with a new EmailMessage object.
  ///
  /// * `message` - The reply message.
  ///
  /// Returns: A promise that resolves when the email message is replied.
  reply(message: "cloudflare:email".EmailMessage): Promise<EmailSendResult>;
}

