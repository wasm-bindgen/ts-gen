  set width(value: f64) as set_width;
  /// The input height in pixels.
  get height: f64;
  set height(value: f64) as set_height;
}

shape class StreamPublicDetails {
  new {};
  /// The public title for the video.
  get title: String | Null;
  set title(value: String) as set_title;
  set title(value: Null) as set_title_with_null;
  /// The public share link.
  get share_link: String | Null;
  set share_link(value: String) as set_share_link;
  set share_link(value: Null) as set_share_link_with_null;
  /// The public channel link.
  get channel_link: String | Null;
  set channel_link(value: String) as set_channel_link;
  set channel_link(value: Null) as set_channel_link_with_null;
  /// The public logo URL.
  get logo: String | Null;
  set logo(value: String) as set_logo;
  set logo(value: Null) as set_logo_with_null;
}

shape class StreamDirectUpload {
  new {};
  /// The URL an unauthenticated upload can use for a single multipart request.
  get uploadURL: String as upload_url;
  set uploadURL(value: String) as set_upload_url;
  /// A Cloudflare-generated unique identifier for a media item.
  get id: String;
  set id(value: String) as set_id;
  /// The watermark profile applied to the upload.
  get watermark: StreamWatermark | Null;
  set watermark(value: StreamWatermark) as set_watermark;
  set watermark(value: Null) as set_watermark_with_null;
  /// The scheduled deletion time, if any.
  get scheduledDeletion: String | Null as scheduled_deletion;
  set scheduledDeletion(value: String) as set_scheduled_deletion;
  set scheduledDeletion(value: Null) as set_scheduled_deletion_with_null;
}

shape class StreamDirectUploadCreateParams {
  new {};
  /// The maximum duration in seconds for a video upload.
  get maxDurationSeconds: f64 as max_duration_seconds;
  set maxDurationSeconds(value: f64) as set_max_duration_seconds;
  /// The date and time after upload when videos will not be accepted.
  get expiry?: String | Undefined;
  set expiry(value: String) as set_expiry;
  /// A user-defined identifier for the media creator.
  get creator?: String | Undefined;
  set creator(value: String) as set_creator;
  /// A user modifiable key-value store used to reference other systems of record for
  /// managing videos.
  get meta?: Record<String> | Undefined;
  set meta(value: Record<String>) as set_meta;
  /// Lists the origins allowed to display the video.
  get allowedOrigins?: Array<String> | Undefined as allowed_origins;
  set allowedOrigins(value: Array<String>) as set_allowed_origins;
  /// Indicates whether the video can be accessed using the id. When set to `true`,
  /// a signed token must be generated with a signing key to view the video.
  get requireSignedURLs?: Boolean | Undefined as require_signed_ur_ls;
  set requireSignedURLs(value: bool) as set_require_signed_ur_ls;
  /// The thumbnail timestamp percentage.
  get thumbnailTimestampPct?: Number | Undefined as thumbnail_timestamp_pct;
  set thumbnailTimestampPct(value: f64) as set_thumbnail_timestamp_pct;
  /// The date and time at which the video will be deleted. Include `null` to remove
  /// a scheduled deletion.
  get scheduledDeletion?: String | Null | Undefined as scheduled_deletion;
  set scheduledDeletion(value: String) as set_scheduled_deletion;
  set scheduledDeletion(value: Null) as set_scheduled_deletion_with_null;
  /// The watermark profile to apply.
  get watermark?: StreamDirectUploadWatermark | Undefined;
  set watermark(value: StreamDirectUploadWatermark) as set_watermark;
}

shape class StreamDirectUploadWatermark {
  new {};
  /// The unique identifier for the watermark profile.
  get id: String;
  set id(value: String) as set_id;
}

shape class StreamUrlUploadParams {
  new {};
  /// Lists the origins allowed to display the video. Enter allowed origin
  /// domains in an array and use `*` for wildcard subdomains. Empty arrays allow the
  /// video to be viewed on any origin.
  get allowedOrigins?: Array<String> | Undefined as allowed_origins;
  set allowedOrigins(value: Array<String>) as set_allowed_origins;
  /// A user-defined identifier for the media creator.
  get creator?: String | Undefined;
  set creator(value: String) as set_creator;
  /// A user modifiable key-value store used to reference other systems of
  /// record for managing videos.
  get meta?: Record<String> | Undefined;
  set meta(value: Record<String>) as set_meta;
  /// Indicates whether the video can be a accessed using the id. When
  /// set to `true`, a signed token must be generated with a signing key to view the
  /// video.
  get requireSignedURLs?: Boolean | Undefined as require_signed_ur_ls;
  set requireSignedURLs(value: bool) as set_require_signed_ur_ls;
  /// Indicates the date and time at which the video will be deleted. Omit
  /// the field to indicate no change, or include with a `null` value to remove an
  /// existing scheduled deletion. If specified, must be at least 30 days from upload
  /// time.
  get scheduledDeletion?: String | Null | Undefined as scheduled_deletion;
  set scheduledDeletion(value: String) as set_scheduled_deletion;
  set scheduledDeletion(value: Null) as set_scheduled_deletion_with_null;
  /// The timestamp for a thumbnail image calculated as a percentage value
  /// of the video's duration. To convert from a second-wise timestamp to a
  /// percentage, divide the desired timestamp by the total duration of the video. If
  /// this value is not set, the default thumbnail image is taken from 0s of the
  /// video.
  get thumbnailTimestampPct?: Number | Undefined as thumbnail_timestamp_pct;
  set thumbnailTimestampPct(value: f64) as set_thumbnail_timestamp_pct;
  /// The identifier for the watermark profile
  get watermarkId?: String | Undefined as watermark_id;
  set watermarkId(value: String) as set_watermark_id;
}

shape class StreamScopedCaptions {
  /// Uploads the caption or subtitle file to the endpoint for a specific BCP47 language.
  /// One caption or subtitle file per language is allowed.
  ///
  /// * `language` - The BCP 47 language tag for the caption or subtitle.
  /// * `file` - The caption or subtitle file to upload.
  ///
  /// Returns: The created caption entry.
  ///
  /// ## Errors
  ///
  /// * `NotFoundError` — if the video is not found
  /// * `BadRequestError` — if the language or file is invalid
  /// * `MaxFileSizeError` — if the file size is too large
  /// * `InternalError` — if an unexpected error occurs
  upload(language: String, file: File): Promise<StreamCaption> raises NotFoundError | BadRequestError | MaxFileSizeError | InternalError;
  /// Generate captions or subtitles for the provided language via AI.
  ///
  /// * `language` - The BCP 47 language tag to generate.
  ///
  /// Returns: The generated caption entry.
  ///
  /// ## Errors
  ///
  /// * `NotFoundError` — if the video is not found
  /// * `BadRequestError` — if the language is invalid
  /// * `StreamError` — if a generated caption already exists
  /// * `StreamError` — if the video duration is too long
  /// * `StreamError` — if the video is missing audio
  /// * `StreamError` — if the requested language is not supported
  /// * `InternalError` — if an unexpected error occurs
  generate(language: String): Promise<StreamCaption> raises NotFoundError | BadRequestError | StreamError | InternalError;
  /// Lists the captions or subtitles.
  /// Use the language parameter to filter by a specific language.
  ///
  /// * `language` - The optional BCP 47 language tag to filter by.
  ///
  /// Returns: The list of captions or subtitles.
  ///
  /// ## Errors
  ///
  /// * `NotFoundError` — if the video or caption is not found
  /// * `InternalError` — if an unexpected error occurs
  list(): Promise<Array<StreamCaption>> raises NotFoundError | InternalError;
  /// Lists the captions or subtitles.
  /// Use the language parameter to filter by a specific language.
  ///
  /// * `language` - The optional BCP 47 language tag to filter by.
  ///
  /// Returns: The list of captions or subtitles.
  ///
  /// ## Errors
  ///
  /// * `NotFoundError` — if the video or caption is not found
  /// * `InternalError` — if an unexpected error occurs
  list(language: String): Promise<Array<StreamCaption>> raises NotFoundError | InternalError as list_with_language;
  /// Removes the captions or subtitles from a video.
  ///
  /// * `language` - The BCP 47 language tag to remove.
  ///
  /// Returns: A promise that resolves when deletion completes.
  ///
  /// ## Errors
  ///
  /// * `NotFoundError` — if the video or caption is not found
  /// * `InternalError` — if an unexpected error occurs
  delete(language: String): Promise<Undefined> raises NotFoundError | InternalError;
}

shape class StreamScopedDownloads {
  /// Generates a download for a video when a video is ready to view. Available
  /// types are `default` and `audio`. Defaults to `default` when omitted.
  ///
  /// * `downloadType` - The download type to create.
  ///
  /// Returns: The current downloads for the video.
  ///
  /// ## Errors
  ///
  /// * `NotFoundError` — if the video is not found
  /// * `BadRequestError` — if the download type is invalid
  /// * `StreamError` — if the video duration is too long to generate a download
  /// * `StreamError` — if the video is not ready to stream
  /// * `InternalError` — if an unexpected error occurs
  generate(): Promise<StreamDownloadGetResponse> raises NotFoundError | BadRequestError | StreamError | InternalError;
  /// Generates a download for a video when a video is ready to view. Available
  /// types are `default` and `audio`. Defaults to `default` when omitted.
  ///
  /// * `downloadType` - The download type to create.
  ///
  /// Returns: The current downloads for the video.
  ///
  /// ## Errors
  ///
  /// * `NotFoundError` — if the video is not found
  /// * `BadRequestError` — if the download type is invalid
  /// * `StreamError` — if the video duration is too long to generate a download
  /// * `StreamError` — if the video is not ready to stream
  /// * `InternalError` — if an unexpected error occurs
  generate(download_type: StreamDownloadType): Promise<StreamDownloadGetResponse> raises NotFoundError | BadRequestError | StreamError | InternalError as generate_with_download_type;
  /// Lists the downloads created for a video.
  ///
  /// Returns: The current downloads for the video.
  ///
  /// ## Errors
  ///
  /// * `NotFoundError` — if the video or downloads are not found
  /// * `InternalError` — if an unexpected error occurs
  get(): Promise<StreamDownloadGetResponse> raises NotFoundError | InternalError;
  /// Delete the downloads for a video. Available types are `default` and `audio`.
  /// Defaults to `default` when omitted.
  ///
  /// * `downloadType` - The download type to delete.
  ///
  /// Returns: A promise that resolves when deletion completes.
  ///
  /// ## Errors
  ///
  /// * `NotFoundError` — if the video or downloads are not found
  /// * `InternalError` — if an unexpected error occurs
  delete(): Promise<Undefined> raises NotFoundError | InternalError;
  /// Delete the downloads for a video. Available types are `default` and `audio`.
  /// Defaults to `default` when omitted.
  ///
  /// * `downloadType` - The download type to delete.
  ///
  /// Returns: A promise that resolves when deletion completes.
  ///
  /// ## Errors
  ///
  /// * `NotFoundError` — if the video or downloads are not found
  /// * `InternalError` — if an unexpected error occurs
  delete(download_type: StreamDownloadType): Promise<Undefined> raises NotFoundError | InternalError as delete_with_download_type;
}

shape class StreamVideos {
  /// Lists all videos in a users account.
  ///
  /// Returns: The list of videos.
  ///
  /// ## Errors
  ///
  /// * `BadRequestError` — if the parameters are invalid
  /// * `InternalError` — if an unexpected error occurs
  list(): Promise<Array<StreamVideo>> raises BadRequestError | InternalError;
  /// Lists all videos in a users account.
  ///
  /// Returns: The list of videos.
  ///
  /// ## Errors
  ///
  /// * `BadRequestError` — if the parameters are invalid
  /// * `InternalError` — if an unexpected error occurs
  list(params: StreamVideosListParams): Promise<Array<StreamVideo>> raises BadRequestError | InternalError as list_with_params;
}

shape class StreamWatermarks {
  /// Generate a new watermark profile
  ///
  /// * `file` - The image file to upload
  /// * `params` - The watermark creation parameters.
  ///
  /// Returns: The created watermark profile.
  ///
  /// ## Errors
  ///
  /// * `BadRequestError` — if the parameters are invalid
  /// * `InvalidURLError` — if the URL is invalid
  /// * `MaxFileSizeError` — if the file size is too large
  /// * `TooManyWatermarksError` — if the number of allowed watermarks is reached
  /// * `InternalError` — if an unexpected error occurs
  generate(file: File, params: StreamWatermarkCreateParams): Promise<StreamWatermark> raises BadRequestError | InvalidURLError | MaxFileSizeError | TooManyWatermarksError | InternalError;
  /// Generate a new watermark profile
  ///
  /// * `url` - The image url to upload
  /// * `params` - The watermark creation parameters.
  ///
  /// Returns: The created watermark profile.
  ///
  /// ## Errors
  ///
  /// * `BadRequestError` — if the parameters are invalid
  /// * `InvalidURLError` — if the URL is invalid
  /// * `MaxFileSizeError` — if the file size is too large
  /// * `TooManyWatermarksError` — if the number of allowed watermarks is reached
  /// * `InternalError` — if an unexpected error occurs
  generate(url: String, params: StreamWatermarkCreateParams): Promise<StreamWatermark> raises BadRequestError | InvalidURLError | MaxFileSizeError | TooManyWatermarksError | InternalError as generate_with_url;
  /// Lists all watermark profiles for an account.
  ///
  /// Returns: The list of watermark profiles.
  ///
  /// ## Errors
  ///
  /// * `InternalError` — if an unexpected error occurs
  list(): Promise<Array<StreamWatermark>> raises InternalError;
  /// Retrieves details for a single watermark profile.
  ///
  /// * `watermarkId` - The watermark profile identifier.
  ///
  /// Returns: The watermark profile details.
  ///
  /// ## Errors
  ///
  /// * `NotFoundError` — if the watermark is not found
  /// * `InternalError` — if an unexpected error occurs
  get(watermark_id: String): Promise<StreamWatermark> raises NotFoundError | InternalError;
  /// Deletes a watermark profile.
  ///
  /// * `watermarkId` - The watermark profile identifier.
  ///
  /// Returns: A promise that resolves when deletion completes.
  ///
  /// ## Errors
  ///
  /// * `NotFoundError` — if the watermark is not found
  /// * `InternalError` — if an unexpected error occurs
  delete(watermark_id: String): Promise<Undefined> raises NotFoundError | InternalError;
}

shape class StreamUpdateVideoParams {
  new {};
  /// Lists the origins allowed to display the video. Enter allowed origin
  /// domains in an array and use `*` for wildcard subdomains. Empty arrays allow the
  /// video to be viewed on any origin.
  get allowedOrigins?: Array<String> | Undefined as allowed_origins;
  set allowedOrigins(value: Array<String>) as set_allowed_origins;
  /// A user-defined identifier for the media creator.
  get creator?: String | Undefined;
  set creator(value: String) as set_creator;
  /// The maximum duration in seconds for a video upload. Can be set for a
  /// video that is not yet uploaded to limit its duration. Uploads that exceed the
  /// specified duration will fail during processing. A value of `-1` means the value
  /// is unknown.
  get maxDurationSeconds?: Number | Undefined as max_duration_seconds;
  set maxDurationSeconds(value: f64) as set_max_duration_seconds;
  /// A user modifiable key-value store used to reference other systems of
  /// record for managing videos.
  get meta?: Record<String> | Undefined;
  set meta(value: Record<String>) as set_meta;
  /// Indicates whether the video can be a accessed using the id. When
  /// set to `true`, a signed token must be generated with a signing key to view the
  /// video.
  get requireSignedURLs?: Boolean | Undefined as require_signed_ur_ls;
  set requireSignedURLs(value: bool) as set_require_signed_ur_ls;
  /// Indicates the date and time at which the video will be deleted. Omit
  /// the field to indicate no change, or include with a `null` value to remove an
  /// existing scheduled deletion. If specified, must be at least 30 days from upload
  /// time.
  get scheduledDeletion?: String | Null | Undefined as scheduled_deletion;
  set scheduledDeletion(value: String) as set_scheduled_deletion;
  set scheduledDeletion(value: Null) as set_scheduled_deletion_with_null;
  /// The timestamp for a thumbnail image calculated as a percentage value
  /// of the video's duration. To convert from a second-wise timestamp to a
  /// percentage, divide the desired timestamp by the total duration of the video. If
  /// this value is not set, the default thumbnail image is taken from 0s of the
  /// video.
  get thumbnailTimestampPct?: Number | Undefined as thumbnail_timestamp_pct;
  set thumbnailTimestampPct(value: f64) as set_thumbnail_timestamp_pct;
}

