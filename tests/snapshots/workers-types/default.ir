  prepend(content: Response, options: ContentOptions): Element as prepend_with_response_and_options;
  append(content: String): Element;
  append(content: ReadableStream): Element as append_with_readable_stream;
  append(content: Response): Element as append_with_response;
  append(content: String, options: ContentOptions): Element as append_with_options;
  append(content: ReadableStream, options: ContentOptions): Element as append_with_readable_stream_and_options;
  append(content: Response, options: ContentOptions): Element as append_with_response_and_options;
  replace(content: String): Element;
  replace(content: ReadableStream): Element as replace_with_readable_stream;
  replace(content: Response): Element as replace_with_response;
  replace(content: String, options: ContentOptions): Element as replace_with_options;
  replace(content: ReadableStream, options: ContentOptions): Element as replace_with_readable_stream_and_options;
  replace(content: Response, options: ContentOptions): Element as replace_with_response_and_options;
  remove(): Element;
  removeAndKeepContent(): Element as remove_and_keep_content;
  setInnerContent(content: String): Element as set_inner_content;
  setInnerContent(content: ReadableStream): Element as set_inner_content_with_readable_stream;
  setInnerContent(content: Response): Element as set_inner_content_with_response;
  setInnerContent(content: String, options: ContentOptions): Element as set_inner_content_with_options;
  setInnerContent(content: ReadableStream, options: ContentOptions): Element as set_inner_content_with_readable_stream_and_options;
  setInnerContent(content: Response, options: ContentOptions): Element as set_inner_content_with_response_and_options;
  onEndTag(handler: (EndTag) => Promise<Undefined> | Undefined) as on_end_tag;
}

shape class EndTag {
