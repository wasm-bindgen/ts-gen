  (import "./bindings.wasm" "Ai.ai_search"
    (func $Ai.ai_search (@abi.call "aiSearch") (@abi.owner "Ai")
      (@abi.ts "aiSearch(): AiSearchAccountService")
      (@abi.doc "Access the AI Search API for managing AI-powered search instances.\n\nThis is the new API that replaces AutoRAG with better namespace separation:\n- Account-level operations: `list()`, `create()`\n- Instance-level operations: `get(id).search()`, `get(id).chatCompletions()`, `get(id).delete()`\n\n## Example\n\n```js\n```typescript\n// List all AI Search instances\nconst instances = await env.AI.aiSearch.list();\n\n// Search an instance\nconst results = await env.AI.aiSearch.get('my-search').search({\n  messages: [{ role: 'user', content: 'What is the policy?' }],\n  ai_search_options: {\n    retrieval: { max_num_results: 10 }\n  }\n});\n\n// Generate chat completions with AI Search context\nconst response = await env.AI.aiSearch.get('my-search').chatCompletions({\n  messages: [{ role: 'user', content: 'What is the policy?' }],\n  model: '@cf/meta/llama-3.3-70b-instruct-fp8-fast'\n});\n```\n```")
      (param $this externref (@abi.ref "Ai"))
      (result externref (@abi.ref "AiSearchAccountService"))))
  (import "./bindings.wasm" "Ai.autorag"
    (func $Ai.autorag (@abi.call "autorag") (@abi.owner "Ai")
      (@abi.ts "autorag(autorag_id: string): AutoRAG")
      (@abi.doc "@deprecated AutoRAG has been replaced by AI Search.\nUse `env.AI.aiSearch` instead for better API design and new features.\n\nMigration guide:\n- `env.AI.autorag().list()` â†’ `env.AI.aiSearch.list()`\n- `env.AI.autorag('id').search({ query: '...' })` â†’ `env.AI.aiSearch.get('id').search({ messages: [{ role: 'user', content: '...' }] })`\n- `env.AI.autorag('id').aiSearch(...)` â†’ `env.AI.aiSearch.get('id').chatCompletions(...)`\n\nNote: The old API continues to work for backwards compatibility, but new projects should use AI Search.\n\n@see AiSearchAccountService\n\n* `autoragId` - Optional instance ID (omit for account-level operations)")
      (param $this externref (@abi.ref "Ai"))
      (param $autorag_id externref (@abi.ref string))
      (result externref (@abi.ref "AutoRAG"))))
