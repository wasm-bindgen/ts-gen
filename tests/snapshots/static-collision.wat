  (import "./bindings.wasm" "Response.json_2" (func $Response.json_2 (param $this externref) (result externref)))
  ;; ok: boolean
  (import "./bindings.wasm" "Response.ok" (func $Response.ok (param $this externref) (result i32)))
  ;; static ok: boolean
  (import "./bindings.wasm" "Response.ok_2" (func $Response.ok_2 (result i32)))

  ;; ResponseInit
  ;; {} as ResponseInit
  (import "./bindings.wasm" "ResponseInit.new" (func $ResponseInit.new (result externref)))
  ;; status?: number
  (import "./bindings.wasm" "ResponseInit.status" (func $ResponseInit.status (param $this externref) (result externref)))
  ;; set status(value: number)
  (import "./bindings.wasm" "ResponseInit.set_status" (func $ResponseInit.set_status (param $this externref) (param $value f64)))

  ;; Counter
