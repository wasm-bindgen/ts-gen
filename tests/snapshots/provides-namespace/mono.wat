;; Generated by ts-gen. Import template for the Wasm ABI.
;;
;; Scalars: number -> f64, boolean -> i32, bigint -> i64.
;; All other values (strings, objects, null/undefined) are externref,
;; as JS produced them. Per position, embed also accepts anyref, and
;; (ref extern) / (ref any) where the TS type never admits null.
;;
;; Import names: Type.member with _with_x suffixes for overloads.
;; Dictionary constructors: Type.new creates {} (empty object).
;; Variables: declare var x -> x getter reading it from its scope.
;;
;; Unused imports need not be deleted; embed prunes to what you use.
(module

  ;; JsValue
  ;; x === undefined
  (import "./bindings.wasm" "JsValue.is_undefined" (func $JsValue.is_undefined (param $x externref) (result i32)))

  ;; Number
  ;; Number(x)
  (import "./bindings.wasm" "Number.value" (func $Number.value (param $x externref) (result f64)))

  ;; Ticket
  ;; constructor(id: number)
  (import "./bindings.wasm" "Ticket.new" (func $Ticket.new (param $id f64) (result externref)))
  ;; id: number
  (import "./bindings.wasm" "Ticket.id" (func $Ticket.id (param $this externref) (result f64)))

  ;; `undefined`, for passing where TS says `T | undefined`.
  (import "./builtins.js" "undefined" (global $undefined externref))

  ;; JSPI: suspends on a Promise and returns its value. Importing this
  ;; selects JSPI mode in `embed`, which wraps the handlers with promising.
  (import "./builtins.js" "await" (func $await (param externref) (result externref)))

  ;; --provides: fill these in; embed publishes them at their JS paths.

  ;; version: version(): number
  (func (export "version") (result f64)
    unreachable)

  ;; add: add(a: number, b: number): number
  (func (export "add") (param $a f64) (param $b f64) (result f64)
    unreachable)

  ;; sum: sum(values: Record<string, number>): number
  (func (export "sum") (param $values externref) (result f64)
    unreachable)

  ;; describeSymbol: describeSymbol(s: symbol): string
  (func (export "describeSymbol") (param $s externref) (result externref)
    unreachable)

  ;; double: double(x: bigint): bigint
  (func (export "double") (param $x i64) (result i64)
    unreachable)

  ;; keys: keys(o: object): string[]
  (func (export "keys") (param $o externref) (result externref)
    unreachable)

  ;; notify: notify(cb: (e: Error | null, n: number) => void): void
  (func (export "notify") (param $cb externref)
    unreachable)

  ;; retOpt: retOpt(x: string | null): string
  (func (export "retOpt") (param $x externref) (result externref)
    unreachable)

  ;; find: find(id: number): string | null
  (func (export "find") (param $id f64) (result externref)
    unreachable)

  ;; api.math.add: add(a: number, b: number): number
  (func (export "api.math.add") (param $a f64) (param $b f64) (result f64)
    unreachable)

  ;; api.str.add: add(a: string, b: string): string
  (func (export "api.str.add") (param $a externref) (param $b externref) (result externref)
    unreachable)

  ;; default.issue: issue(id: number): Ticket
  (func (export "issue") (param $id f64) (result externref)
    unreachable)

  ;; default.describe: describe(ticket: Ticket | null): string
  (func (export "describe") (param $ticket externref) (result externref)
    unreachable)

  ;; default.add: add(a: number): number
  (func (export "default.add") (param $a f64) (result f64)
    unreachable)
)
