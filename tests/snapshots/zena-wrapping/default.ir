ir 1;

class Item {
  new() throws;
  get name: String;
  get label?: String | Undefined;
  set label(value: String) as set_label;
  get parent: Item | Null;
  set parent(value: Item) as set_parent;
  set parent(value: Null) as set_parent_with_null;
}

function find(name: String): Item | Null;
function find(name: Null): Item | Null as find_with_null;
function find(name: String, fallback: Item): Item | Null as find_with_fallback;
function find(name: Null, fallback: Item): Item | Null as find_with_null_and_fallback;
function first(): Item | Undefined;
function title(): String | Undefined;
function join(sep: String, ...parts: Array<String>): String;

provide handle(item: Item | Null, name: String | Undefined, label: String): Item | Undefined;
provide pick(item: Item, flag: bool): String | Null;
