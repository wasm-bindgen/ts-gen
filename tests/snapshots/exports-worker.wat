;; Generated by ts-gen. Import template for the Wasm ABI.
;;
;; Scalars: number -> f64, boolean -> i32, bigint -> i64.
;; All other values (strings, objects, null/undefined) are externref,
;; as JS produced them. Per position, embed also accepts anyref, and
;; (ref extern) where the TS type is not nullable.
;;
;; Import names: Type.member with _with_x suffixes for overloads.
;; Dictionary constructors: Type.new creates {} (empty object).
;; Global vars: declare var x -> x getter reading globalThis.x.
;;
;; Declarations from `declare module` are reached through the merged
;; module's own ESM imports of:
;;   "exports-worker"
;;
;; Unused imports need not be deleted; embed prunes to what you use.
(module

  ;; JsValue
  ;; x === undefined
  (import "./bindings.wasm" "JsValue.is_undefined" (func $JsValue.is_undefined (param $x externref) (result i32)))

  ;; Number
  ;; Number(x)
  (import "./bindings.wasm" "Number.value" (func $Number.value (param $x externref) (result f64)))

  ;; Request
  ;; constructor(url: string)
  (import "./bindings.wasm" "Request.new" (func $Request.new (param $url externref) (result externref)))
  ;; url: string
  (import "./bindings.wasm" "Request.url" (func $Request.url (param $this externref) (result externref)))

  ;; Response
  ;; constructor(body: string)
  (import "./bindings.wasm" "Response.new" (func $Response.new (param $body externref) (result externref)))
  ;; body: string
  (import "./bindings.wasm" "Response.body" (func $Response.body (param $this externref) (result externref)))

  ;; ExecutionContext
  ;; constructor()
  (import "./bindings.wasm" "ExecutionContext.new" (func $ExecutionContext.new (result externref)))
  ;; waitUntil(promise: Promise<any>): void
  (import "./bindings.wasm" "ExecutionContext.wait_until" (func $ExecutionContext.wait_until (param $this externref) (param $promise externref)))

  ;; ExportedHandler
  ;; fetch(request: Request, env: E, ctx: ExecutionContext): Promise<Response>
  (import "./bindings.wasm" "ExportedHandler.fetch" (func $ExportedHandler.fetch (param $this externref) (param $request externref) (param $env externref) (param $ctx externref) (result externref)))
  ;; scheduled(cron: string, env: E): Promise<void>
  (import "./bindings.wasm" "ExportedHandler.scheduled" (func $ExportedHandler.scheduled (param $this externref) (param $cron externref) (param $env externref) (result externref)))
  ;; tail(events: string[], env: E): void
  (import "./bindings.wasm" "ExportedHandler.tail" (func $ExportedHandler.tail (param $this externref) (param $events externref) (param $env externref)))

  ;; `undefined`, for passing where TS says `T | undefined`.
  (import "./builtins.js" "undefined" (global $undefined externref))

  ;; JSPI: suspends on a Promise and returns its value. Importing this
  ;; selects JSPI mode in `embed`, which wraps the handlers with promising.
  (import "./builtins.js" "await" (func $await (param externref) (result externref)))

  ;; --exports: fill these in; embed publishes them at their JS paths.

  ;; default.fetch: fetch(request: Request, env: any, ctx: ExecutionContext): Promise<Response>
  (func (export "fetch") (param $request externref) (param $env externref) (param $ctx externref) (result externref)
    unreachable)

  ;; default.tail: tail(events: string[], env: any): void
  (func (export "tail") (param $events externref) (param $env externref)
    unreachable)
)
