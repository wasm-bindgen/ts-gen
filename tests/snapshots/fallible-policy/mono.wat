  (import "./bindings.wasm" "Headers.new" (func $Headers.new (result externref)))
  ;; constructor(init: Record<string, string>)
  (import "./bindings.wasm" "Headers.new_with_init" (func $Headers.new_with_init (param $init externref) (result externref)))
  ;; get(name: string): string | null
  (import "./bindings.wasm" "Headers.get" (func $Headers.get (param $this externref) (param $name externref) (result externref)))
  ;; set(name: string, value: string): void
  (import "./bindings.wasm" "Headers.set" (func $Headers.set (param $this externref) (param $name externref) (param $value externref)))
  ;; has(name: string): boolean
  (import "./bindings.wasm" "Headers.has" (func $Headers.has (param $this externref) (param $name externref) (result i32)))
  ;; text(): Promise<string>
  (import "./bindings.wasm" "Headers.text" (func $Headers.text (param $this externref) (result externref)))
  ;; size: number
  (import "./bindings.wasm" "Headers.size" (func $Headers.size (param $this externref) (result f64)))
  ;; consumedText: string
  (import "./bindings.wasm" "Headers.consumed_text" (func $Headers.consumed_text (param $this externref) (result externref)))
  ;; label: string
  (import "./bindings.wasm" "Headers.label" (func $Headers.label (param $this externref) (result externref)))
  ;; set label(value: string)
  (import "./bindings.wasm" "Headers.set_label" (func $Headers.set_label (param $this externref) (param $value externref)))
  ;; parse(raw: string): Headers
  (import "./bindings.wasm" "Headers.parse" (func $Headers.parse (param $raw externref) (result externref)))
  ;; static defaults: Headers
  (import "./bindings.wasm" "Headers.defaults" (func $Headers.defaults (result externref)))

  ;; compute(x: number): number
  (import "./bindings.wasm" "compute" (func $compute (param $x f64) (result f64)))
  ;; pureCompute(x: number): number
  (import "./bindings.wasm" "pureCompute" (func $pureCompute (param $x f64) (result f64)))

  ;; `undefined`, for passing where TS says `T | undefined`.
  (import "./builtins.js" "undefined" (global $undefined externref))

  ;; JSPI: suspends on a Promise and returns its value. Importing this
  ;; selects JSPI mode in `embed`, which wraps the handlers with promising.
  (import "./builtins.js" "await" (func $await (param externref) (result externref)))
)
