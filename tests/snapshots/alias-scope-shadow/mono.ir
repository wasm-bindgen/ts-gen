ir 1;

shape class Pair<A, B> {
  new {}: Pair;
  get a: A | Null | Undefined;
  set a(value: A | Null | Undefined) as set_a;
  get b: B | Null | Undefined;
  set b(value: B | Null | Undefined) as set_b;
}

shape class Inner {
  new {};
  get top: String;
  set top(value: String) as set_top;
}

static class Shadow {
  static use(a: Pair<Inner, Inner>, b: Pair<Inner, Inner>) throws as use_;
  static wrapped(a: Array<Pair<Inner, Inner>>, b: Promise<Pair<Inner, Inner>>): Pair<Inner, Inner> | Null throws;
  static either(a: InnerOrName, b: Chained): InnerOrName throws;
  static name(n: Names) throws;
  static own(i: Shadow.Inner) throws;
  static hold(h: Holder<Mode>): Holder<Mode> throws;
  static next(): Promise<Mode>;
}

shape class Shadow.Inner {
  new {};
  get shadow: bool;
  set shadow(value: bool) as set_shadow;
}

shape class Shadow.Mode {
  new {};
  get shadow: bool;
  set shadow(value: bool) as set_shadow;
}

class Holder<T> {
  new(value: T | Null | Undefined): Holder throws;
  get(): T | Null | Undefined throws;
}

kind InnerOrName fallback {
  String = String;
  Inner = Inner;
}

kind Chained fallback {
  String = String;
  Inner = Inner;
}

kind Names {
  String = String;
  F64 = Number;
}

kind Mode {
  Fast = "fast";
  Slow = "slow";
}
