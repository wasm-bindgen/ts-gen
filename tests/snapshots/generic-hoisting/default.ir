ir 1;

module "generic-hoisting" {
  class Envelope<Meta, Body> {
    new(label: String): Envelope throws;
    get label: String;
    forward(other: Envelope): String;
    copy(): Envelope;
  }

  class Courier {
    new(first: Envelope) throws;
    send(envelope: Envelope): String;
    sendLabelled(envelope: Envelope<String>): String as send_labelled;
    sendAsync(envelope: Envelope): Promise<String> as send_async;
    sendEither(envelope: Envelope): String as send_either;
    sendEither(envelope: String): String as send_either_with_str;
    sendMaybe(envelope: Envelope | Undefined, tag: String): String as send_maybe;
    static check(envelope: Envelope): String;
  }

  kind Loose {
    F64 = Number;
    String = String;
  }

  function post(envelope: Envelope): String;
  function postAsync(envelope: Envelope): Promise<String> as post_async;
  function relay<Meta>(envelope: Envelope, meta: Meta | Null | Undefined): String;
}
