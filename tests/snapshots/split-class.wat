  ;; ForwardableEmailMessage
  ;; reply(message: EmailMessage): Promise<void>
  (import "./bindings.wasm" "ForwardableEmailMessage.reply" (func $ForwardableEmailMessage.reply (param $this externref) (param $message externref) (result externref)))

