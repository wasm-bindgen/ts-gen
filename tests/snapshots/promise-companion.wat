;; Generated by ts-gen. Import template for the Wasm ABI.
;;
;; Scalars: number -> f64, boolean -> i32, bigint -> i64.
;; All other values (strings, objects, null/undefined) are externref,
;; as JS produced them. Per position, embed also accepts anyref, and
;; (ref extern) / (ref any) where the TS type never admits null.
;;
;; Import names: Type.member with _with_x suffixes for overloads.
;; Dictionary constructors: Type.new creates {} (empty object).
;; Variables: declare var x -> x getter reading it from its scope.
;;
;; Unused imports need not be deleted; embed prunes to what you use.
(module

  ;; JsValue
  ;; x === undefined
  (import "./bindings.wasm" "JsValue.is_undefined" (func $JsValue.is_undefined (param $x externref) (result i32)))

  ;; Number
  ;; Number(x)
  (import "./bindings.wasm" "Number.value" (func $Number.value (param $x externref) (result f64)))

  ;; State
  ;; blockConcurrencyWhile(callback: () => Promise<void>): Promise<void>
  (import "./bindings.wasm" "State.block_concurrency_while" (func $State.block_concurrency_while (param $this externref) (param $callback externref) (result externref)))
  ;; fetch(url: string): Promise<Response>
  (import "./bindings.wasm" "State.fetch" (func $State.fetch (param $this externref) (param $url externref) (result externref)))
  ;; fetch(url: string, init: RequestInit): Promise<Response>
  (import "./bindings.wasm" "State.fetch_with_init" (func $State.fetch_with_init (param $this externref) (param $url externref) (param $init externref) (result externref)))
  ;; get(key: string): Promise<string | null>
  (import "./bindings.wasm" "State.get" (func $State.get (param $this externref) (param $key externref) (result externref)))
  ;; ready(): Promise<boolean>
  (import "./bindings.wasm" "State.ready" (func $State.ready (param $this externref) (result externref)))
  ;; id(): string
  (import "./bindings.wasm" "State.id" (func $State.id (param $this externref) (result externref)))
  ;; done: Promise<void>
  (import "./bindings.wasm" "State.done" (func $State.done (param $this externref) (result externref)))

  ;; RequestInit
  ;; {} as RequestInit
  (import "./bindings.wasm" "RequestInit.new" (func $RequestInit.new (result externref)))
  ;; method?: string
  (import "./bindings.wasm" "RequestInit.method" (func $RequestInit.method (param $this externref) (result externref)))
  ;; set method(value: string)
  (import "./bindings.wasm" "RequestInit.set_method" (func $RequestInit.set_method (param $this externref) (param $value externref)))

  ;; sleep(ms: number): Promise<void>
  (import "./bindings.wasm" "sleep" (func $sleep (param $ms f64) (result externref)))

  ;; `undefined`, for passing where TS says `T | undefined`.
  (import "./builtins.js" "undefined" (global $undefined externref))

  ;; JSPI: suspends on a Promise and returns its value. Importing this
  ;; selects JSPI mode in `embed`, which wraps the handlers with promising.
  (import "./builtins.js" "await" (func $await (param externref) (result externref)))
)
