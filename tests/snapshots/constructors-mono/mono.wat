  ;; type: "bytes"
  (import "./bindings.wasm" "UnderlyingByteSource.type" (func $UnderlyingByteSource.type (param $this externref) (result externref)))
  ;; set type(value: "bytes")
  (import "./bindings.wasm" "UnderlyingByteSource.set_type" (func $UnderlyingByteSource.set_type (param $this externref) (param $value externref)))

  ;; Stream
  ;; constructor()
  (import "./bindings.wasm" "Stream.new" (func $Stream.new (result externref)))
  ;; constructor(source: UnderlyingByteSource)
  (import "./bindings.wasm" "Stream.new_with_source" (func $Stream.new_with_source (param $source externref) (result externref)))
  ;; locked: boolean
  (import "./bindings.wasm" "Stream.locked" (func $Stream.locked (param $this externref) (result i32)))

  ;; Transform
  ;; constructor()
  (import "./bindings.wasm" "Transform.new" (func $Transform.new (result externref)))
  ;; constructor(transformer: UnderlyingSource<I>)
  (import "./bindings.wasm" "Transform.new_with_transformer" (func $Transform.new_with_transformer (param $transformer externref) (result externref)))
  ;; readable: Stream<O>
  (import "./bindings.wasm" "Transform.readable" (func $Transform.readable (param $this externref) (result externref)))

  ;; Reader
  ;; constructor(stream: Stream)
  (import "./bindings.wasm" "Reader.new" (func $Reader.new (param $stream externref) (result externref)))
  ;; read(): Promise<R>
  (import "./bindings.wasm" "Reader.read" (func $Reader.read (param $this externref) (result externref)))

  ;; `undefined`, for passing where TS says `T | undefined`.
  (import "./builtins.js" "undefined" (global $undefined externref))

  ;; JSPI: suspends on a Promise and returns its value. Importing this
  ;; selects JSPI mode in `embed`, which wraps the handlers with promising.
  (import "./builtins.js" "await" (func $await (param externref) (result externref)))
)
