ir 1;

module "generic-defaults" {
  shape class Box<T> {
    get value: T | Null | Undefined;
    set(value: T | Null | Undefined) throws;
  }

  class Holder<T, U> {
    new(): Holder throws;
    get(): T | Null | Undefined throws;
    boxed(): U | Null | Undefined throws;
    static make(): Holder<String, Any | Null | Undefined> throws;
  }

  shape class Options<T> {
    new {}: Options;
    get initial?: T | Null | Undefined;
    set initial(value: T | Null | Undefined) as set_initial;
  }

  shape class Row<T> {
    new {}: Row;
    get results: Array<T | Null | Undefined>;
    set results(value: Array<T | Null | Undefined>) as set_results;
  }

  shape class Cursor<T> {
    next(): T | Null | Undefined throws;
  }

  shape class Store {
    put<T>(key: String, value: T | Null | Undefined): Promise<Undefined> throws;
    append<T>(...items: Array<T | Null | Undefined>): Row<T | Null | Undefined> throws;
    get<T>(key: String): Promise<T | Null | Undefined> throws;
    first<T>(): Promise<T | Null | Undefined> throws;
    json<T>(): Promise<T | Null | Undefined> throws;
    transaction<T>(closure: (Store) => Promise<T | Null | Undefined>): Promise<T | Null | Undefined> throws;
    collect(make: () => Promise<Any | Null | Undefined>): Promise<Map<String, Any | Null | Undefined>> throws;
    each<T>(fn: (T | Null | Undefined) => void): Promise<Map<String, T | Null | Undefined>> throws;
    eachRest(fn: (Any | Null | Undefined, Array<Any | Null | Undefined>) => void): Promise<Map<String, Any | Null | Undefined>> throws as each_rest;
    run(): Promise<Row<Record<Any | Null | Undefined>>> throws;
    list(): Promise<Map<String, Any | Null | Undefined>> throws;
    scan(): Cursor<String> throws;
    schedule(callback: (Any | Null | Undefined) => void, ...args: Array<Any | Null | Undefined>): f64 throws;
  }

  kind Loose {
    F64 = Number;
    String = String;
  }

  function looseBox(): Box<Any | Null | Undefined> throws as loose_box;
  function looseHolder(): Holder<Any, Box<Any>> throws as loose_holder;
  function stringHolder(): Holder<String, Box<String>> throws as string_holder;
  function mixedHolder(): Holder<String, Box<Any | Null | Undefined>> throws as mixed_holder;
  function makeHolder(): Holder<String, Any | Null | Undefined> throws as make_holder;
  function of<T>(...items: Array<T | Null | Undefined>): Row<T | Null | Undefined> throws;
  function enterSpan<T>(name: String, fn: (Any | Null | Undefined) => T | Null | Undefined, ...args: Array<Any | Null | Undefined>): T | Null | Undefined throws as enter_span;
  function lookup(): Map<String, Number> throws;
  function lookup(key: String) throws as lookup_with_key;
}
