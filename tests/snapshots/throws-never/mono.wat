;; Generated by ts-gen. Import template for the Wasm ABI.
;;
;; Scalars: number -> f64, boolean -> i32, bigint -> i64.
;; All other values (strings, objects, null/undefined) are externref,
;; as JS produced them. Per position, embed also accepts anyref, and
;; (ref extern) / (ref any) where the TS type never admits null.
;;
;; Import names: Type.member with _with_x suffixes for overloads.
;; Dictionary constructors: Type.new creates {} (empty object).
;; Variables: declare var x -> x getter reading it from its scope.
;;
;; Unused imports need not be deleted; embed prunes to what you use.
(module

  ;; JsValue
  ;; x === undefined
  (import "./bindings.wasm" "JsValue.is_undefined" (func $JsValue.is_undefined (param $x externref) (result i32)))

  ;; Number
  ;; Number(x)
  (import "./bindings.wasm" "Number.value" (func $Number.value (param $x externref) (result f64)))

  ;; NeverThrows
  ;; safeOp(x: number): string
  (import "./bindings.wasm" "NeverThrows.safe_op" (func $NeverThrows.safe_op (param $this externref) (param $x f64) (result externref)))
  ;; loaded(): Promise<Loaded>
  (import "./bindings.wasm" "NeverThrows.loaded" (func $NeverThrows.loaded (param $this externref) (result externref)))
  ;; normalOp(x: number): string
  (import "./bindings.wasm" "NeverThrows.normal_op" (func $NeverThrows.normal_op (param $this externref) (param $x f64) (result externref)))
  ;; typedOp(x: number): string
  (import "./bindings.wasm" "NeverThrows.typed_op" (func $NeverThrows.typed_op (param $this externref) (param $x f64) (result externref)))
  ;; constructor(name: string)
  (import "./bindings.wasm" "NeverThrows.new" (func $NeverThrows.new (param $name externref) (result externref)))

  ;; Loaded
  ;; {} as Loaded
  (import "./bindings.wasm" "Loaded.new" (func $Loaded.new (result externref)))
  ;; ready: boolean
  (import "./bindings.wasm" "Loaded.ready" (func $Loaded.ready (param $this externref) (result i32)))

  ;; pureCompute(x: number): number
  (import "./bindings.wasm" "pureCompute" (func $pureCompute (param $x f64) (result f64)))
  ;; infallibleFetch(url: string): Promise<string>
  (import "./bindings.wasm" "infallibleFetch" (func $infallibleFetch (param $url externref) (result externref)))

  ;; `undefined`, for passing where TS says `T | undefined`.
  (import "./builtins.js" "undefined" (global $undefined externref))

  ;; JSPI: suspends on a Promise and returns its value. Importing this
  ;; selects JSPI mode in `embed`, which wraps the handlers with promising.
  (import "./builtins.js" "await" (func $await (param externref) (result externref)))
)
