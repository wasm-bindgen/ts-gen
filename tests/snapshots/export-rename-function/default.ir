ir 1;

module "node:thing" {
  class Server as _Server {
    new(port: f64) throws;
    stop();
  }
  alias Server = _Server;
}

shape class Socket {
  close(): Promise<Undefined>;
}

module "node:thing" {
  function connect(address: String): Socket;
  function serve(port: f64);
  function listenOn(port: f64) as listen_on;
  function shutdown();
  get version: String;
}

function _listen(host: String) as listen;

module "node:other" {
  function _close(): bool as close;
}
