;; JS values are externref, as JS produced them. Per position, embed also
;; accepts anyref, and (ref extern) / (ref any) where the type admits
;; neither Null nor Undefined.
;;
;; Unused imports need not be deleted; embed prunes to what you use.
(module

  ;; x === undefined
  (import "./bindings.wasm" "JsValue.is_undefined" (func $JsValue.is_undefined (param $x externref) (result i32)))
  ;; undefined
  (import "./bindings.wasm" "JsValue.undefined" (func $JsValue.undefined (result externref)))
  ;; Number(x)
  (import "./bindings.wasm" "Number.value" (func $Number.value (param $x externref) (result f64)))

  ;; new(o: "dep".Options) throws;
  (import "import-require-module" "Walker.new" (func $import-require-module:Walker.new (param $o externref) (result externref)))
  ;; walk();
  (import "import-require-module" "Walker.walk" (func $import-require-module:Walker.walk (param $this externref)))

  ;; new {};
  (import "dep" "Options.new" (func $dep:Options.new (result externref)))
  ;; get depth: f64;
  (import "dep" "Options.depth" (func $dep:Options.depth (param $this externref) (result f64)))
  ;; set depth(value: f64) as set_depth;
  (import "dep" "Options.set_depth" (func $dep:Options.set_depth (param $this externref) (param $value f64)))

  ;; function walk(o: "dep".Options): Walker;
  (import "import-require-module" "walk" (func $import-require-module:walk (param $o externref) (result externref)))

  ;; `undefined`, for passing where a type admits Undefined.
  (import "./builtins.js" "undefined" (global $undefined externref))
  ;; JSPI: suspends on a Promise and returns its value. Importing this
  ;; selects JSPI mode in `embed`, which wraps the provides with promising.
  (import "./builtins.js" "await" (func $await (param externref) (result externref)))
