;; Generated by ts-gen. Import template for the Wasm ABI.
;;
;; Scalars: number -> f64, boolean -> i32, bigint -> i64.
;; All other values (strings, objects, null/undefined) are externref,
;; as JS produced them. Per position, embed also accepts anyref, and
;; (ref extern) / (ref any) where the TS type never admits null.
;;
;; Import names: Type.member with _with_x suffixes for overloads.
;; Dictionary constructors: Type.new creates {} (empty object).
;; Variables: declare var x -> x getter reading it from its scope.
;;
;; Declarations from `declare module "spec"` are imported from "spec".
;;
;; Unused imports need not be deleted; embed prunes to what you use.
(module

  ;; JsValue
  ;; x === undefined
  (import "./bindings.wasm" "JsValue.is_undefined" (func $JsValue.is_undefined (param $x externref) (result i32)))

  ;; Number
  ;; Number(x)
  (import "./bindings.wasm" "Number.value" (func $Number.value (param $x externref) (result f64)))

  ;; Error
  ;; constructor(message: string)
  (import "./bindings.wasm" "Error.new" (func $Error.new (param $message externref) (result externref)))
  ;; message: string
  (import "./bindings.wasm" "Error.message" (func $Error.message (param $this externref) (result externref)))

  ;; String
  ;; length: number
  (import "./bindings.wasm" "String.length" (func $String.length (param $this externref) (result f64)))

  ;; isEmpty(x: string): boolean
  (import "./bindings.wasm" "isEmpty" (func $isEmpty (param $x externref) (result i32)))
  ;; isUndefined(x: string): boolean
  (import "./bindings.wasm" "isUndefined" (func $isUndefined (param $x externref) (result i32)))
  ;; numberValue(): number
  (import "./bindings.wasm" "numberValue" (func $numberValue (result f64)))
  ;; const Undefined: number
  (import "./bindings.wasm" "Undefined" (func $Undefined (result f64)))
  ;; await_(p: Promise<void>): void
  (import "./bindings.wasm" "await_" (func $await_ (param $p externref)))
  ;; describe(e: Error, s: string): string
  (import "./bindings.wasm" "describe" (func $describe (param $e externref) (param $s externref) (result externref)))

  ;; Message
  ;; constructor()
  (import "./bindings.wasm" "Message.new" (func $Message.new (result externref)))
  ;; create(n: number): Message
  (import "./bindings.wasm" "Message.create" (func $Message.create (param $n f64) (result externref)))

  ;; send(m: string): void
  (import "./bindings.wasm" "send" (func $send (param $m externref)))
  ;; send(m: string): void
  (import "mail" "send" (func $mail:send (param $m externref)))
  ;; send(m: string, opt: number): void
  (import "mail" "send_with_opt" (func $mail:send_with_opt (param $m externref) (param $opt f64)))

  ;; `undefined`, for passing where TS says `T | undefined`.
  (import "./builtins.js" "undefined" (global $undefined externref))

  ;; JSPI: suspends on a Promise and returns its value. Importing this
  ;; selects JSPI mode in `embed`, which wraps the handlers with promising.
  (import "./builtins.js" "await" (func $await (param externref) (result externref)))
)
