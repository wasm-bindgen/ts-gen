;; neither Null nor Undefined.
;;
;; Unused imports need not be deleted; embed prunes to what you use.
(module

  ;; x === undefined
  (import "./bindings.wasm" "JsValue.is_undefined" (func $JsValue.is_undefined (param $x externref) (result i32)))
  ;; undefined
  (import "./bindings.wasm" "JsValue.undefined" (func $JsValue.undefined (result externref)))
  ;; Number(x)
  (import "./bindings.wasm" "Number.value" (func $Number.value (param $x externref) (result f64)))

  ;; bar();
  (import "module-export-aliases" "_Foo.bar" (func $module-export-aliases:_Foo.bar (param $this externref)))

  ;; new() throws;
  (import "module-export-aliases" "_Conn.new" (func $module-export-aliases:_Conn.new (result externref)))
  ;; get(): String;
  (import "module-export-aliases" "_Conn.get" (func $module-export-aliases:_Conn.get (param $this externref) (result externref)))
