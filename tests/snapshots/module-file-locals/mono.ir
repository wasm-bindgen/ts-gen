ir 1;

module "module-file-locals" {
  class Foo as _Foo {
    new() throws;
    bar() throws;
  }
  alias Foo = _Foo;

  class Server as _Server {
    listen() throws;
  }
  alias Server = _Server;

  shape class Options {
    new {};
    get depth: f64;
    set depth(value: f64) as set_depth;
  }

  class Hidden {
    m() throws;
  }

  function configure(o: Options): _Foo throws;
  function ren() throws;
  function reveal(): Hidden throws;
}
