ir 1;

module "no-cross-file-names" {
  function useSecret(s: Secret | Null | Undefined) throws as use_secret;
  function useShared(s: Shared | Null | Undefined) throws as use_shared;
  function a() throws;
  function b() throws;
}

module "no-cross-file-names-dep" {
  function useHidden(h: Hidden | Null | Undefined) throws as use_hidden;
}
