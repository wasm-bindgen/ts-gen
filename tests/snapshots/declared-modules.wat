  (import "declared-modules/fs" "constants.O_RDONLY" (func $declared-modules/fs:constants.O_RDONLY (result f64)))

  ;; open(path: string): Handle
  (import "declared-modules/fs" "open" (func $declared-modules/fs:open (param $path externref) (result externref)))

  ;; constants
  ;; const O_RDONLY: number
  (import "declared-modules/os" "constants.O_RDONLY" (func $declared-modules/os:constants.O_RDONLY (result f64)))

  ;; constants.signals
  ;; const SIGINT: number
  (import "declared-modules/os" "constants.signals.SIGINT" (func $declared-modules/os:constants.signals.SIGINT (result f64)))

  ;; hostname(): string
  (import "declared-modules/os" "hostname" (func $declared-modules/os:hostname (result externref)))

  ;; Handle
  ;; {} as Handle
  (import "./bindings.wasm" "Handle.new" (func $Handle.new (result externref)))
  ;; fd: number
  (import "./bindings.wasm" "Handle.fd" (func $Handle.fd (param $this externref) (result f64)))
  ;; set fd(value: number)
  (import "./bindings.wasm" "Handle.set_fd" (func $Handle.set_fd (param $this externref) (param $value f64)))

  ;; DeclaredModules
  ;; const VERSION: string
  (import "./bindings.wasm" "DeclaredModules.VERSION" (func $DeclaredModules.VERSION (result externref)))

