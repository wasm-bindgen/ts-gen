ir 1;

class Blob {}

class Stream {}

interface Chunk {
  @js(object)
  new();
  get size(): f64;
  set size(value: f64);
}

interface Part {
  @js(object)
  new();
  get name(): str;
  set name(value: str);
}

send(body: union Body) throws;
sendMaybe() throws;
sendMaybe(body: union Body) throws;
sendAny(body: union BodyKind) throws;
sendPiece(piece: Piece) throws;
sendPayload(body: union Body) throws;
sendLoose(body: union Body) throws;
wrapDefault(w: Wrapped) throws;
wrapBlob(w: union WrappedBlob) throws;
tagged(t: union Tagged) throws;

interface Handler {
  receive(body: union Body) throws;
  take(piece: Piece) throws;
}

scalar(v: @js(null) union VKind?) throws;

interface Settings {
  @js(object)
  new();
  get id(): str;
  set id(value: str);
  get cache(): bool?;
  set cache(value: bool);
}

interface Universal {
  @js(object)
  new();
  get extra(): str?;
  set extra(value: str);
  get id(): str;
  set id(value: str);
  get cache(): bool?;
  set cache(value: bool);
}

configure(s: Universal) throws;

class Box<T> {
  get value(): T;
  set value(value: T);
}

digest(data: buffer): ArrayBuffer throws;
store(key: str, value: union ValueKind) throws;
storeBlob(value: union ValueKind2) throws;
load(): @js(null) buffer? throws;
loadText(): BufferOrStr throws;
join(parts: arr<buffer>): future<buffer>;
boxed(): Box<BufferSource> throws;
/// * `data`
hash(data: buffer) throws;
/// * `data`
hash(data: *buffer) throws;
/// * `data`
hashText(data: str) throws;
/// * `data`
hashText(data: buffer) throws;
/// * `data`
hashText(data: *buffer) throws;

interface Frame {
  @js(object)
  new();
  get payload(): buffer;
  set payload(value: buffer);
  get tag(): BufferOrStr?;
  set tag(value: union BufferOrStr);
}

enum Body {
  Str(str);
  Blob(Blob);
  Stream(Stream);
}

enum BodyKind {
  Str(str);
  Blob(Blob);
}

enum Piece {
  Chunk(Chunk);
  Part(Part);
}

enum Wrapped {
  Chunk(Chunk);
  Part(Part);
}

enum WrappedBlob {
  Blob(Blob);
  Part(Part);
}

enum Tagged {
  Blob(Blob);
  Stream(Stream);
}

enum VKind {
  Str(str);
  F64(f64);
}

enum ValueKind {
  Str(str);
  Buffer(buffer);
}

enum ValueKind2 {
  Blob(Blob);
  Buffer(buffer);
  Str(str);
}

enum BufferOrStr {
  Buffer(buffer);
  Str(str);
}

enum BufferSource {
  ArrayBuffer(ArrayBuffer);
  ArrayBufferView(ArrayBufferView);
}

export namespace default {
  receive(body: Body) throws;
  take(piece: Chunk) throws;
  take(piece: Part) throws;
}

class ArrayBuffer {}

interface ArrayBufferView {}
